<Application ShutdownMode="OnExplicitShutdown"
             StartupUri="MainWindow.xaml"
             x:Class="SylverInk.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:conv="clr-namespace:SylverInk.Mvvm.Converters"
             xmlns:local="clr-namespace:SylverInk.XAML"
             xmlns:mvvm="clr-namespace:SylverInk.Mvvm"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ControlTemplate TargetType="{x:Type MenuItem}"
                             x:Key="MenuItemTemplate">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        x:Name="HeaderBorder">
                    <Grid x:Name="HeaderGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ContentPresenter ContentSource="Header"
                                          Margin="5,3"
                                          VerticalAlignment="Center" />

                        <Path Grid.Column="1"
                              Data="M0,0 L4,4 L8,0"
                              Margin="6,0"
                              Stroke="{TemplateBinding Foreground}"
                              VerticalAlignment="Center"
                              Visibility="Collapsed"
                              x:Name="Arrow" />

                        <Popup AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Bottom"
                               x:Name="PART_Popup">
                            <Border Background="{Binding Source={x:Static mvvm:ViewModelBase.AppSettings}, Path=MenuBackground}"
                                    BorderBrush="{Binding Source={x:Static mvvm:ViewModelBase.AppSettings}, Path=ListForeground}"
                                    BorderThickness="1"
                                    Margin="{TemplateBinding Padding}">
                                <ItemsPresenter KeyboardNavigation.TabNavigation="Cycle" />
                            </Border>
                        </Popup>
                    </Grid>
                </Border>

                <ControlTemplate.Triggers>
                    <Trigger Property="Role"
                             Value="SubmenuHeader">
                        <Setter TargetName="Arrow"
                                Property="Visibility"
                                Value="Visible" />

                        <Setter TargetName="PART_Popup"
                                Property="Placement"
                                Value="Right" />

                        <Setter Property="MinWidth"
                                Value="120" />
                    </Trigger>

                    <Trigger Property="Role"
                             Value="SubmenuItem">
                        <Setter Property="MinWidth"
                                Value="120" />
                    </Trigger>

                    <Trigger Property="IsEnabled"
                             Value="False">
                        <Setter Property="Background"
                                Value="{Binding Source={x:Static mvvm:ViewModelBase.AppSettings}, Path=DisabledBackground}" />
                        <Setter Property="BorderBrush"
                                Value="{Binding Source={x:Static mvvm:ViewModelBase.AppSettings}, Path=DisabledBackground}" />
                        <Setter Property="Foreground"
                                Value="{Binding Source={x:Static mvvm:ViewModelBase.AppSettings}, Path=DisabledForeground}" />
                    </Trigger>

                    <Trigger Property="IsMouseOver"
                             Value="True">
                        <Setter Property="Background"
                                Value="{Binding Source={x:Static mvvm:ViewModelBase.AppSettings}, Path=ListBackground}" />
                        <Setter Property="BorderBrush"
                                Value="{Binding Source={x:Static mvvm:ViewModelBase.AppSettings}, Path=ListForeground}" />
                        <Setter Property="Foreground"
                                Value="{Binding Source={x:Static mvvm:ViewModelBase.AppSettings}, Path=ListForeground}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <DataTemplate DataType="{x:Type sys:String}">
                <Grid>
                    <Viewbox Stretch="Uniform"
                             StretchDirection="DownOnly">
                        <TextBlock Text="{Binding}" />
                    </Viewbox>
                </Grid>
            </DataTemplate>

            <Style TargetType="{x:Type Button}">
                <Setter Property="Background"
                        Value="{Binding AppSettings.ListBackground}" />
                <Setter Property="FontFamily"
                        Value="{Binding AppSettings.MainFontFamily}" />
                <Setter Property="FontSize"
                        Value="{Binding AppSettings.MainFontSize}" />
                <Setter Property="Foreground"
                        Value="{Binding AppSettings.ListForeground}" />
                <Setter Property="Height"
                        Value="Auto" />
                <Setter Property="HorizontalAlignment"
                        Value="Center" />
                <Setter Property="HorizontalContentAlignment"
                        Value="Center" />
                <Setter Property="Margin"
                        Value="2" />
                <Setter Property="MinHeight"
                        Value="20" />
                <Setter Property="MinWidth"
                        Value="75" />
                <Setter Property="VerticalAlignment"
                        Value="Center" />
                <Setter Property="VerticalContentAlignment"
                        Value="Center" />
                <Setter Property="Width"
                        Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{Binding AppSettings.MenuForeground}"
                                    BorderThickness="1"
                                    x:Name="Border">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled"
                                         Value="False">
                                    <Setter Property="Background"
                                            Value="{Binding AppSettings.DisabledBackground}" />
                                    <Setter Property="Foreground"
                                            Value="{Binding AppSettings.DisabledForeground}" />
                                </Trigger>

                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="{Binding AppSettings.AccentBackground}" />
                                    <Setter Property="Foreground"
                                            Value="{Binding AppSettings.AccentForeground}" />
                                </Trigger>

                                <Trigger Property="IsPressed"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="{Binding AppSettings.ActivatedBackground}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type CheckBox}">
                <Setter Property="VerticalAlignment"
                        Value="Center" />
            </Style>

            <Style TargetType="{x:Type ComboBox}">
                <Setter Property="Background"
                        Value="{Binding AppSettings.ListBackground}" />
                <Setter Property="FontFamily"
                        Value="{Binding AppSettings.MainFontFamily}" />
                <Setter Property="FontSize"
                        Value="{Binding AppSettings.MainFontSize}" />
                <Setter Property="Foreground"
                        Value="{Binding AppSettings.ListForeground}" />
                <Setter Property="VerticalContentAlignment"
                        Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>

                                <ToggleButton ClickMode="Press"
                                              Focusable="False"
                                              Grid.ColumnSpan="2"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{Binding AppSettings.ListBackground}"
                                                    BorderBrush="{Binding AppSettings.AccentBackground}"
                                                    BorderThickness="1"
                                                    SnapsToDevicePixels="true"
                                                    x:Name="templateRoot">
                                                <Grid HorizontalAlignment="Right"
                                                      Width="20">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="20" />
                                                    </Grid.ColumnDefinitions>

                                                    <Path Data="M0,0 L4,4 L8,0 Z"
                                                          Fill="{Binding AppSettings.AccentForeground}"
                                                          Grid.Column="1"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          x:Name="arrow" />
                                                </Grid>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="true">
                                                    <Setter Property="Background"
                                                            TargetName="templateRoot"
                                                            Value="{Binding AppSettings.AccentBackground}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  HorizontalAlignment="Left"
                                                  IsHitTestVisible="False"
                                                  Margin="5,3,0,3"
                                                  VerticalAlignment="Center"
                                                  x:Name="contentPresenter" />

                                <Popup AllowsTransparency="true"
                                       Grid.ColumnSpan="2"
                                       IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       Placement="Bottom"
                                       PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}"
                                       x:Name="PART_Popup">
                                    <Border Background="{Binding AppSettings.ListBackground}"
                                            BorderBrush="{Binding AppSettings.AccentBackground}"
                                            BorderThickness="1"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            x:Name="dropDownBorder">
                                        <ScrollViewer CanContentScroll="True"
                                                      FontFamily="{Binding AppSettings.MainFontFamily}"
                                                      FontSize="{Binding AppSettings.MainFontSize}"
                                                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                      x:Name="DropDownScrollViewer">
                                            <Grid RenderOptions.ClearTypeHint="Enabled"
                                                  x:Name="grid">
                                                <Canvas Height="0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Width="0"
                                                        x:Name="canvas">
                                                    <Rectangle Fill="{Binding Background, ElementName=dropDownBorder}"
                                                               Height="{Binding ActualHeight, ElementName=dropDownBorder}"
                                                               Width="{Binding ActualWidth,ElementName=dropDownBorder}"
                                                               x:Name="opaqueRect" />
                                                </Canvas>

                                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                                x:Name="ItemsPresenter" />
                                            </Grid>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type ContextMenu}">
                <Setter Property="Background"
                        Value="{Binding ListBackground}" />
                <Setter Property="BorderBrush"
                        Value="{Binding ListForeground}" />
                <Setter Property="BorderThickness"
                        Value="1" />
                <Setter Property="Foreground"
                        Value="{Binding ListForeground}" />
                <Setter Property="Padding"
                        Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ItemsPresenter KeyboardNavigation.TabNavigation="Cycle" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type DatePicker}">
                <Setter Property="Background"
                        Value="{Binding AppSettings.ListBackground}" />
                <Setter Property="BorderBrush"
                        Value="{Binding AppSettings.ListForeground}" />
                <Setter Property="FontFamily"
                        Value="{Binding AppSettings.MainFontFamily}" />
                <Setter Property="FontSize"
                        Value="{Binding AppSettings.MainFontSize}" />
                <Setter Property="Foreground"
                        Value="{Binding AppSettings.ListForeground}" />
                <Setter Property="HorizontalContentAlignment"
                        Value="Center" />
                <Setter Property="VerticalContentAlignment"
                        Value="Center" />
            </Style>

            <Style TargetType="{x:Type DatePickerTextBox}">
                <Setter Property="Background"
                        Value="Transparent" />
                <Setter Property="VerticalContentAlignment"
                        Value="Center" />
            </Style>

            <Style TargetType="{x:Type Label}">
                <Setter Property="FontFamily"
                        Value="{Binding AppSettings.MainFontFamily}" />
                <Setter Property="FontSize"
                        Value="{Binding AppSettings.MainFontSize}" />
                <Setter Property="Foreground"
                        Value="{Binding AppSettings.MenuForeground}" />
                <Setter Property="HorizontalContentAlignment"
                        Value="Center" />
                <Setter Property="ToolTipService.InitialShowDelay"
                        Value="250" />
                <Setter Property="VerticalContentAlignment"
                        Value="Center" />
            </Style>

            <Style TargetType="{x:Type ListBox}">
                <Setter Property="Background"
                        Value="{Binding AppSettings.ListBackground}" />
                <Setter Property="BorderBrush"
                        Value="{Binding AppSettings.MenuForeground}" />
                <Setter Property="BorderThickness"
                        Value="1" />
                <Setter Property="FontFamily"
                        Value="{Binding AppSettings.MainFontFamily}" />
                <Setter Property="FontSize"
                        Value="{Binding AppSettings.MainFontSize}" />
                <Setter Property="Foreground"
                        Value="{Binding AppSettings.ListForeground}" />
            </Style>

            <Style TargetType="{x:Type ListBoxItem}"
                   x:Key="LBIStyle">
                <Style.Triggers>
                    <Trigger Property="ListBox.AlternationIndex"
                             Value="1">
                        <Setter Property="Background"
                                Value="{Binding Path=DataContext.AppSettings.Background}" />
                        <Setter Property="Foreground"
                                Value="{Binding Path=DataContext.AppSettings.Foreground}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="{x:Type Menu}">
                <Setter Property="Background"
                        Value="{Binding Source={x:Static mvvm:ViewModelBase.AppSettings}, Path=MenuBackground}" />
                <Setter Property="Foreground"
                        Value="{Binding Source={x:Static mvvm:ViewModelBase.AppSettings}, Path=MenuForeground}" />
            </Style>

            <Style TargetType="{x:Type MenuItem}">
                <Setter Property="Background"
                        Value="{Binding Source={x:Static mvvm:ViewModelBase.AppSettings}, Path=MenuBackground}" />
                <Setter Property="BorderBrush"
                        Value="{Binding Source={x:Static mvvm:ViewModelBase.AppSettings}, Path=MenuBackground}" />
                <Setter Property="BorderThickness"
                        Value="1" />
                <Setter Property="Foreground"
                        Value="{Binding Source={x:Static mvvm:ViewModelBase.AppSettings}, Path=MenuForeground}" />
                <Setter Property="Padding"
                        Value="3,1" />
                <Setter Property="Template"
                        Value="{StaticResource MenuItemTemplate}" />
            </Style>

            <Style BasedOn="{StaticResource {x:Type MenuItem}}"
                   TargetType="{x:Type MenuItem}"
                   x:Key="ContextMenuItemStyle">
                <Setter Property="Background"
                        Value="{Binding Source={x:Static mvvm:ViewModelBase.AppSettings}, Path=MenuBackground}" />
                <Setter Property="BorderBrush"
                        Value="{Binding Source={x:Static mvvm:ViewModelBase.AppSettings}, Path=AccentBackground}" />
                <Setter Property="Foreground"
                        Value="{Binding Source={x:Static mvvm:ViewModelBase.AppSettings}, Path=MenuForeground}" />
                <Setter Property="Padding"
                        Value="3,1" />
                <Setter Property="Template"
                        Value="{StaticResource MenuItemTemplate}" />
            </Style>

            <Style x:Key="PopoutStyle"
                   TargetType="{x:Type local:Popout}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:Popout}">
                            <Grid>
                                <Border Background="{Binding AppSettings.MenuBackground}"
                                        BorderBrush="{Binding AppSettings.AccentBackground}"
                                        BorderThickness="1.5"
                                        CornerRadius="4">
                                    <ContentPresenter />
                                </Border>

                                <ResizeGrip HorizontalAlignment="Right"
                                            Margin="0,0,2,2"
                                            VerticalAlignment="Bottom" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type RichTextBox}">
                <Setter Property="AcceptsReturn"
                        Value="True" />
                <Setter Property="Background"
                        Value="{Binding AppSettings.ListBackground}" />
                <Setter Property="BorderBrush"
                        Value="{Binding AppSettings.MenuForeground}" />
                <Setter Property="FontFamily"
                        Value="{Binding AppSettings.MainFontFamily}" />
                <Setter Property="FontSize"
                        Value="{Binding AppSettings.MainFontSize}" />
                <Setter Property="Foreground"
                        Value="{Binding AppSettings.ListForeground}" />
                <Setter Property="HorizontalScrollBarVisibility"
                        Value="Auto" />
                <Setter Property="UndoLimit"
                        Value="20" />
                <Setter Property="VerticalScrollBarVisibility"
                        Value="Auto" />
            </Style>

            <Style TargetType="{x:Type Separator}">
                <Setter Property="BorderBrush"
                        Value="{Binding AppSettings.AccentBackground}" />
                <Setter Property="BorderThickness"
                        Value="1" />
                <Setter Property="Margin"
                        Value="0,3" />
            </Style>

            <Style TargetType="{x:Type Separator}"
                   x:Key="{x:Static MenuItem.SeparatorStyleKey}">
                <Setter Property="Margin"
                        Value="0,3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Rectangle Fill="{Binding AppSettings.AccentBackground}"
                                       Height="1" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SliderThumbStyle"
                   TargetType="{x:Type Thumb}">
                <Setter Property="Background"
                        Value="{Binding AppSettings.ListBackground}" />
                <Setter Property="Foreground"
                        Value="{Binding AppSettings.ListForeground}" />
                <Setter Property="OverridesDefaultStyle"
                        Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Viewbox Height="18"
                                     Width="18">
                                <Polygon Fill="{TemplateBinding Background}"
                                         Height="36"
                                         Points="7,3 7.25,2 8,1 9,0.25 10,0 26,0 27,0.25 28,1 28.75,2 29,3 29,23 28.75,24.5 28,26 18,36 8,26 7.25,24.5 7,23"
                                         Stroke="{TemplateBinding Foreground}"
                                         StrokeThickness="2"
                                         Width="36"
                                         x:Name="Thumb_Polygon" />
                            </Viewbox>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsDragging"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="{Binding AppSettings.MenuBackground}" />

                                    <Setter Property="Foreground"
                                            Value="{Binding AppSettings.AccentForeground}" />
                                </Trigger>

                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter Property="Foreground"
                                            Value="{Binding AppSettings.AccentForeground}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type Slider}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Slider}">
                            <Grid Grid.IsSharedSizeScope="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"
                                                   MinHeight="{TemplateBinding MinHeight}" />

                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TickBar Fill="{Binding AppSettings.ListForeground}"
                                         Grid.Row="0"
                                         Height="4"
                                         Margin="0,0,0,2"
                                         Placement="Top"
                                         Visibility="Collapsed"
                                         x:Name="TopTick" />

                                <Grid Grid.Row="1"
                                      MinHeight="18"
                                      VerticalAlignment="Center">
                                    <Border Background="{Binding AppSettings.ListForeground}"
                                            BorderBrush="{Binding AppSettings.AccentBackground}"
                                            BorderThickness="0.5"
                                            CornerRadius="3"
                                            Height="6"
                                            x:Name="TrackBackground" />

                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                          Template="{x:Null}" />
                                        </Track.DecreaseRepeatButton>

                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource SliderThumbStyle}"
                                                   x:Name="Track_Thumb" />
                                        </Track.Thumb>

                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                          Template="{x:Null}" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>

                                <TickBar Fill="{Binding AppSettings.ListForeground}"
                                         Grid.Row="2"
                                         Height="4"
                                         Margin="0,2,0,0"
                                         Placement="Bottom"
                                         Visibility="Collapsed"
                                         x:Name="BottomTick" />
                            </Grid>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin"
                                         Value="True">
                                    <Setter Property="Background"
                                            TargetName="Track_Thumb"
                                            Value="{Binding AppSettings.MenuBackground}" />

                                    <Setter Property="Foreground"
                                            TargetName="Track_Thumb"
                                            Value="{Binding AppSettings.AccentForeground}" />
                                </Trigger>

                                <Trigger Property="TickPlacement"
                                         Value="TopLeft">
                                    <Setter Property="Visibility"
                                            TargetName="TopTick"
                                            Value="Visible" />
                                </Trigger>

                                <Trigger Property="TickPlacement"
                                         Value="BottomRight">
                                    <Setter Property="Visibility"
                                            TargetName="BottomTick"
                                            Value="Visible" />
                                </Trigger>

                                <Trigger Property="TickPlacement"
                                         Value="Both">
                                    <Setter Property="Visibility"
                                            TargetName="TopTick"
                                            Value="Visible" />

                                    <Setter Property="Visibility"
                                            TargetName="BottomTick"
                                            Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type TabItem}">
                <Setter Property="FontFamily"
                        Value="{Binding AppSettings.MainFontFamily}" />
                <Setter Property="Foreground"
                        Value="{Binding AppSettings.MenuForeground}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabItem}">
                            <Grid Margin="0,4,0,0"
                                  x:Name="ContentSite">
                                <Border Background="{Binding AppSettings.MenuBackground}"
                                        BorderBrush="{Binding AppSettings.AccentBackground}"
                                        BorderThickness="1,1,1,0"
                                        Name="Border">
                                    <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="Center"
                                                      RecognizesAccessKey="True"
                                                      VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected"
                                         Value="True">

                                    <Setter Property="Background"
                                            TargetName="Border"
                                            Value="{Binding AppSettings.ListBackground}" />

                                    <Setter Property="TextElement.Foreground"
                                            TargetName="Border"
                                            Value="{Binding AppSettings.ListForeground}" />

                                    <Setter Property="Margin"
                                            TargetName="ContentSite"
                                            Value="0" />

                                    <Setter Property="Panel.ZIndex"
                                            Value="100" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type TextBox}">
                <Setter Property="Background"
                        Value="{Binding AppSettings.ListBackground}" />
                <Setter Property="BorderBrush"
                        Value="{Binding AppSettings.MenuForeground}" />
                <Setter Property="FontFamily"
                        Value="{Binding AppSettings.MainFontFamily}" />
                <Setter Property="FontSize"
                        Value="{Binding AppSettings.MainFontSize}" />
                <Setter Property="Foreground"
                        Value="{Binding AppSettings.ListForeground}" />
                <Setter Property="Height"
                        Value="Auto" />
                <Setter Property="MinHeight"
                        Value="20" />
                <Setter Property="MinWidth"
                        Value="75" />
                <Setter Property="VerticalContentAlignment"
                        Value="Center" />
                <Setter Property="Width"
                        Value="Auto" />
            </Style>

            <Style TargetType="{x:Type ToggleButton}"
                   x:Key="ToggleButtonStyle">
                <Setter Property="Background"
                        Value="{Binding AppSettings.ListBackground}" />
                <Setter Property="FontFamily"
                        Value="{Binding AppSettings.MainFontFamily}" />
                <Setter Property="FontSize"
                        Value="{Binding AppSettings.MainFontSize}" />
                <Setter Property="FontStyle"
                        Value="Italic" />
                <Setter Property="Foreground"
                        Value="{Binding AppSettings.ListForeground}" />
                <Setter Property="Height"
                        Value="Auto" />
                <Setter Property="HorizontalAlignment"
                        Value="Center" />
                <Setter Property="HorizontalContentAlignment"
                        Value="Center" />
                <Setter Property="Margin"
                        Value="2" />
                <Setter Property="MinHeight"
                        Value="20" />
                <Setter Property="MinWidth"
                        Value="75" />
                <Setter Property="VerticalAlignment"
                        Value="Center" />
                <Setter Property="VerticalContentAlignment"
                        Value="Center" />
                <Setter Property="Width"
                        Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{Binding AppSettings.MenuForeground}"
                                    BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled"
                                         Value="False">
                                    <Setter Property="Background"
                                            Value="{Binding AppSettings.DisabledBackground}" />
                                    <Setter Property="Foreground"
                                            Value="{Binding AppSettings.DisabledForeground}" />
                                </Trigger>

                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="{Binding AppSettings.AccentBackground}" />
                                    <Setter Property="Foreground"
                                            Value="{Binding AppSettings.AccentForeground}" />
                                </Trigger>

                                <Trigger Property="IsChecked"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="{Binding AppSettings.ActivatedBackground}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
