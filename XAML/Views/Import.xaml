<Window x:Class="SylverInk.XAML.Import"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SylverInk"
        xmlns:properties="clr-namespace:SylverInk.Localization"
        xmlns:vm="clr-namespace:SylverInk.XAML.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:ImportViewModel}"
        mc:Ignorable="d"
        Background="{Binding AppSettings.MenuBackground}"
        Foreground="{Binding AppSettings.MenuForeground}"
        Height="375"
        MinHeight="325"
        MinWidth="225"
        MouseLeftButtonDown="Drag"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Title="{x:Static properties:Strings.Title_Import}"
        Topmost="True"
        Width="325">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel>
            <Label Content="{x:Static properties:Strings.Label_FileToImport}"
                   FontStyle="Italic"
                   HorizontalAlignment="Right"
                   Margin="0,20,30,0"/>
            
            <Grid Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Command="{Binding OpenCommand}"
                        Content="..."
                        Height="Auto"
                        HorizontalAlignment="Right"
                        Margin="5,5,5,5"
                        MinHeight="20"
                        MinWidth="20"
                        Width="Auto"/>
                
                <TextBox Grid.Column="1"
                         IsReadOnly="True"
                         Margin="5,5,5,5"
                         Text="{Binding ImportTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            
            <Grid Margin="0,25,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Command="{Binding ImportCommand}"
                        Content="{x:Static properties:Strings.Word_Import}"
                        IsEnabled="{Binding CanImport}"
                        Width="Auto"/>
                
                <Button Command="{Binding CloseCommand}"
                        Content="{x:Static properties:Strings.Word_Close}"
                        Grid.Column="1"
                        Width="Auto"/>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="1"
              HorizontalAlignment="Center"
              Margin="0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Label Content="{x:Static properties:Strings.Label_AdaptiveNotes}"/>
            
            <CheckBox Command="{Binding ToggleAdaptiveCommand}"
                      Grid.Column="1"
                      IsChecked="{Binding AdaptiveImport, Mode=TwoWay}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
            
            <Label Foreground="{Binding AppSettings.AccentForeground}"
                   Grid.Column="2"
                   ToolTip="{x:Static properties:Strings.AdaptiveNotesTooltip}">
                <TextBlock Text="(?)" TextDecorations="Underline"/>
            </Label>
            
            <Label Content="{x:Static properties:Strings.Label_LineTolerance}"
                   Grid.Row="2"/>
            
            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Center"
                        IsEnabled="{Binding ManualImport}"
                        Orientation="Horizontal"
                        Grid.Row="2">
                <Button Command="{Binding LineToleranceChangeCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                        Content="-"
                        MinWidth="20"
                        Width="Auto"/>
                
                <TextBox HorizontalContentAlignment="Center"
                         IsReadOnly="True"
                         Text="{Binding LineTolerance}"
                         MinWidth="25"
                         Width="Auto"/>
                
                <Button Command="{Binding LineToleranceChangeCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                        Content="+"
                        MinWidth="20"
                        Width="Auto"/>
            </StackPanel>
            
            <Label Foreground="{Binding AppSettings.AccentForeground}"
                   Grid.Column="2"
                   Grid.Row="2"
                   ToolTip="{x:Static properties:Strings.LineToleranceTooltip}">
                <TextBlock Text="(?)" TextDecorations="Underline"/>
            </Label>
        </Grid>
        
        <Border BorderBrush="{Binding AppSettings.MenuForeground}"
                BorderThickness="1"
                Grid.Row="2"
                Margin="20,5,20,20">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <TextBlock Background="{Binding AppSettings.ListBackground}"
                           FontFamily="{Binding AppSettings.MainFontFamily}"
                           FontSize="{Binding AppSettings.MainFontSize}"
                           Foreground="{Binding AppSettings.ListForeground}"
                           Text="{Binding StatusText}"
                           TextWrapping="WrapWithOverflow"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
