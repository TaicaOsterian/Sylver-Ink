<local:Popout x:Class="SylverInk.XAML.ImageView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:local="clr-namespace:SylverInk.XAML"
              xmlns:properties="clr-namespace:SylverInk.Localization"
              xmlns:vm="clr-namespace:SylverInk.XAML.ViewModels"
              mc:Ignorable="d"
              d:DataContext="{d:DesignInstance Type=vm:ImageViewViewModel}"
              Activated="WindowActivated"
              AllowsTransparency="True"
              Background="{x:Null}"
              Closed="Result_Closed"
              Deactivated="WindowDeactivated"
              Height="400"
              Loaded="WindowLoaded"
              MinHeight="125"
              MinWidth="175"
              MouseDown="WindowMouseDown"
              MouseEnter="WindowMouseEnter"
              MouseLeave="WindowMouseLeave"
              MouseMove="WindowMove"
              MouseUp="WindowMouseUp"
              ResizeMode="CanResizeWithGrip"
              ShowInTaskbar="{Binding AppSettings.StickyNotesInTaskbar}"
              Style="{StaticResource PopoutStyle}"
              Title="Sylver Ink: Image View"
              Topmost="{Binding AppSettings.StickyNotesOnTop}"
              Width="400"
              WindowStyle="None">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{Binding AppSettings.MenuBackground}"
                BorderBrush="{Binding AppSettings.AccentBackground}"
                BorderThickness="1.5"
                Grid.ColumnSpan="2">
            <Viewbox>
                <Image Source="{Binding Source}"/>
            </Viewbox>
        </Border>

        <Button Command="{Binding ExportCommand}"
                Grid.Row="1"
                Content="{x:Static properties:Strings.Word_Export}"
                IsEnabled="{Binding IsFocused}"
                Margin="0,2"
                MinWidth="50"
                Padding="5"/>

        <Button Command="{Binding CloseCommand}"
                Grid.Column="1"
                Grid.Row="1"
                Content="{x:Static properties:Strings.Word_Close}"
                IsEnabled="{Binding IsFocused}"
                Margin="0,2"
                MinWidth="50"
                Padding="5"/>
    </Grid>
</local:Popout>
