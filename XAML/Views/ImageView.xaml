<local:Popout x:Class="SylverInk.XAML.ImageView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:local="clr-namespace:SylverInk.XAML"
              xmlns:properties="clr-namespace:SylverInk.Localization"
              xmlns:vm="clr-namespace:SylverInk.XAML.ViewModels"
              mc:Ignorable="d"
              d:DataContext="{d:DesignInstance Type=vm:ImageViewViewModel}"
              Activated="WindowActivated"
              Background="{x:Null}"
              Closed="Result_Closed"
              Deactivated="WindowDeactivated"
              Height="350"
              Loaded="WindowLoaded"
              MinHeight="125"
              MinWidth="175"
              MouseDown="WindowMouseDown"
              MouseEnter="WindowMouseEnter"
              MouseLeave="WindowMouseLeave"
              MouseMove="WindowMove"
              MouseUp="WindowMouseUp"
              ResizeMode="CanResizeWithGrip"
              ShowInTaskbar="{Binding AppSettings.StickyNotesInTaskbar}"
              Style="{StaticResource PopoutStyle}"
              Title="Sylver Ink: Image View"
              Topmost="{Binding AppSettings.StickyNotesOnTop}"
              Width="350">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{Binding AppSettings.MenuBackground}"
                BorderBrush="{Binding AppSettings.AccentBackground}"
                BorderThickness="1.5"
                ClipToBounds="True"
                Grid.ColumnSpan="2">
            <Grid>
                <ItemsControl Background="{Binding AppSettings.AccentBackground}"
                              ClipToBounds="True">
                    <Canvas Loaded="Canvas_Loaded" />
                </ItemsControl>

                <Canvas>
                    <Button Click="Canvas_ZoomClick"
                            Content="-"
                            Height="20"
                            Canvas.Left="5"
                            MinHeight="0"
                            MinWidth="0"
                            Canvas.Top="5"
                            Width="20" />

                    <Button Click="Canvas_ZoomClick"
                            Content="+"
                            Height="20"
                            Canvas.Left="30"
                            MinHeight="0"
                            MinWidth="0"
                            Canvas.Top="5"
                            Width="20" />

                    <Button Click="Canvas_ZoomClick"
                            Content="{Binding ZoomLevelRender}"
                            Height="20"
                            Canvas.Left="55"
                            MinHeight="0"
                            MinWidth="0"
                            Padding="2"
                            Canvas.Top="5"
                            Width="40" />
                </Canvas>
            </Grid>
        </Border>

        <Button Command="{Binding ExportCommand}"
                Grid.Row="1"
                Content="{x:Static properties:Strings.Word_Export}"
                IsEnabled="{Binding IsFocused}"
                Margin="0,5"
                MinWidth="50"
                Padding="5" />

        <Button Command="{Binding CloseCommand}"
                Grid.Column="1"
                Grid.Row="1"
                Content="{x:Static properties:Strings.Word_Close}"
                IsEnabled="{Binding IsFocused}"
                Margin="0,5"
                MinWidth="50"
                Padding="5" />
    </Grid>
</local:Popout>
