<Window x:Class="SylverInk.XAML.Properties"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SylverInk"
        xmlns:properties="clr-namespace:SylverInk.Localization"
        xmlns:vm="clr-namespace:SylverInk.XAML.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PropertiesViewModel}"
        Title="{x:Static properties:Strings.Title_Properties}"
        Height="450"
        MinHeight="400"
        MinWidth="275"
        MouseLeftButtonDown="Drag"
        ShowInTaskbar="False"
        Topmost="True"
        Width="350">
    <Grid Background="{Binding AppSettings.MenuBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock FontFamily="{Binding AppSettings.MainFontFamily}"
                   FontSize="{Binding AppSettings.MainFontSize}"
                   FontWeight="Bold"
                   Foreground="{Binding AppSettings.MenuForeground}"
                   Margin="15"
                   Text="{Binding DBName}"
                   TextAlignment="Center"
                   TextWrapping="WrapWithOverflow"
                   VerticalAlignment="Center"
                   x:Name="DBNameLabel"/>

        <TabControl Background="{Binding AppSettings.MenuBackground}"
                    BorderThickness="0"
                    Grid.Row="1">
            <TabItem Margin="0,0,0,-2">
                <TabItem.Header>
                    <TextBlock FontFamily="{Binding AppSettings.MainFontFamily}"
                               FontSize="{Binding AppSettings.MainFontSize}"
                               Margin="3"
                               Text="{x:Static properties:Strings.Word_File}"/>
                </TabItem.Header>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Popup Height="25"
                           Placement="Mouse"
                           PopupAnimation="Fade"
                           StaysOpen="False"
                           Width="160"
                           x:Name="TimeSelector">
                        <Border BorderBrush="{Binding AppSettings.MenuForeground}"
                                BorderThickness="1">
                            <Grid Background="{Binding AppSettings.MenuBackground}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox ItemsSource="{Binding Hours}"
                                          MaxDropDownHeight="160"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          SelectedItem="{Binding Hour, Mode=TwoWay}"/>

                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Minutes}"
                                          MaxDropDownHeight="160"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          SelectedItem="{Binding Minute, Mode=TwoWay}"/>

                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding Meridians}"
                                          MaxDropDownHeight="160"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          SelectedItem="{Binding Meridian, Mode=TwoWay}"/>
                            </Grid>
                        </Border>
                    </Popup>

                    <Label Content="{x:Static properties:Strings.Word_Created}"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"
                           Margin="5,0"/>

                    <Label Content="{x:Static properties:Strings.Word_Format}"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"
                           Grid.Row="1"
                           Margin="5,0"/>

                    <Label Content="{x:Static properties:Strings.Word_Path}"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"
                           Grid.Row="2"
                           Margin="5,0"/>

                    <Label Content="{Binding DBCreated}"
                           Grid.Column="1"
                           HorizontalAlignment="Left"
                           x:Name="DBCreatedLabel"/>

                    <Label Content="{Binding DBFormat}"
                           Grid.Column="1"
                           Grid.Row="1"
                           HorizontalAlignment="Left"
                           x:Name="DBFormatLabel"/>

                    <TextBlock FontFamily="{Binding AppSettings.MainFontFamily}"
                               FontSize="{Binding AppSettings.MainFontSize}"
                               Foreground="{Binding AppSettings.MenuForeground}"
                               Grid.Column="1"
                               Grid.Row="2"
                               HorizontalAlignment="Left"
                               Text="{Binding DBPath}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               x:Name="DBPathLabel"/>

                    <Separator Grid.ColumnSpan="2"
                               Grid.Row="3"
                               Margin="0,3"/>

                    <Label Content="{x:Static properties:Strings.Label_Restore}"
                           FontStyle="Italic"
                           Grid.Row="4"
                           Grid.RowSpan="3"
                           HorizontalAlignment="Right"
                           Margin="10"
                           VerticalAlignment="Center"/>

                    <DatePicker CalendarOpened="CalendarOpened"
                                Grid.Column="1"
                                Grid.Row="4"
                                Margin="0,5"
                                MaxWidth="120"
                                SelectedDate="{Binding RestoreDate, Mode=TwoWay}"/>

                    <Button Click="SelectTime"
                            Content="{Binding TimeString}"
                            FontStyle="Normal"
                            Grid.Column="1"
                            Grid.Row="5"
                            Margin="0,5"
                            x:Name="SelectedTime"/>

                    <Button Command="{Binding RestoreCommand}"
                            Content="{x:Static properties:Strings.Word_Restore}"
                            Grid.Column="1"
                            Grid.Row="6"
                            Margin="0,10,0,5"/>
                </Grid>
            </TabItem>

            <TabItem Margin="0,0,0,-2">
                <TabItem.Header>
                    <TextBlock FontFamily="{Binding AppSettings.MainFontFamily}"
                               FontSize="{Binding AppSettings.MainFontSize}"
                               Margin="3"
                               Text="{x:Static properties:Strings.Word_Content}"/>
                </TabItem.Header>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Label Content="{x:Static properties:Strings.NoteCount}"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"
                           Margin="5,0"/>

                    <Label FontWeight="Bold"
                           HorizontalAlignment="Right"
                           Margin="5,0"
                           Grid.Row="1">
                        <TextBlock Text="{x:Static properties:Strings.AverageLength}"
                                   TextAlignment="Right"/>
                    </Label>

                    <Label Content="{x:Static properties:Strings.TotalLength}"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"
                           Margin="5,0"
                           Grid.Row="2"/>

                    <Label Content="{x:Static properties:Strings.LongestNote}"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"
                           Margin="5,0"
                           Grid.Row="3"/>

                    <Label Content="{Binding DBNotes}"
                           Grid.Column="1"
                           HorizontalAlignment="Left"
                           x:Name="DBNotesLabel"/>

                    <Label Content="{Binding DBAvg}"
                           Grid.Column="1"
                           Grid.Row="1"
                           HorizontalAlignment="Left"
                           x:Name="DBAvgLabel"/>

                    <Label Content="{Binding DBTotal}"
                           Grid.Column="1"
                           Grid.Row="2"
                           HorizontalAlignment="Left"
                           x:Name="DBTotalLabel"/>

                    <Label Content="{Binding DBLongest}"
                           Grid.Column="1"
                           Grid.Row="3"
                           HorizontalAlignment="Left"
                           x:Name="DBLongestLabel"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Separator Grid.ColumnSpan="2"
                   Grid.Row="2"
                   Margin="0,3"/>

        <Button Command="{Binding CloseCommand}"
                Content="{x:Static properties:Strings.Word_Close}"
                Grid.ColumnSpan="2"
                Grid.Row="3"
                Margin="0,20"/>
    </Grid>
</Window>
