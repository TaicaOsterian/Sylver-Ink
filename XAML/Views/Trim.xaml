<Window x:Class="SylverInk.XAML.Trim"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:properties="clr-namespace:SylverInk.Localization"
        xmlns:vm="clr-namespace:SylverInk.XAML.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:TrimViewModel}"
        Background="{Binding AppSettings.AccentBackground}"
        Height="300"
        Loaded="Trim_Loaded"
        MinHeight="225"
        MinWidth="225"
        MouseLeftButtonDown="Drag"
        SizeToContent="Height"
        ShowInTaskbar="False"
        Title="{x:Static properties:Strings.Title_Trim}"
        Topmost="True"
        Width="250">
    <Grid Background="{Binding AppSettings.MenuBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Label FontStyle="Italic"
                   HorizontalAlignment="Right"
                   Margin="10,0">
                <TextBlock Text="{x:Static properties:Strings.Label_RemoveEmptyNotes}"
                           TextAlignment="Right"
                           TextWrapping="WrapWithOverflow" />
            </Label>

            <Label FontStyle="Italic"
                   HorizontalAlignment="Right"
                   Margin="10,0"
                   Grid.Row="1">
                <TextBlock Text="{x:Static properties:Strings.Label_RemoveOldRevisions}"
                           TextAlignment="Right"
                           TextWrapping="WrapWithOverflow" />
            </Label>

            <CheckBox Grid.Column="1"
                      HorizontalAlignment="Left"
                      IsChecked="{Binding ShouldDeleteEmptyNotes}"
                      Margin="0,5" />

            <CheckBox Grid.Column="1"
                      HorizontalAlignment="Left"
                      IsChecked="{Binding ShouldDeleteOldRevisions}"
                      Margin="0,5"
                      Grid.Row="1" />
        </Grid>
        
        <Separator Grid.ColumnSpan="2"
                   Grid.Row="1" />

        <Button Command="{Binding TrimCommand}"
                Content="{x:Static properties:Strings.Word_Trim}"
                Foreground="{Binding AppSettings.MenuForeground}"
                Grid.Row="2"
                HorizontalAlignment="Right"
                Margin="10" />

        <Button Command="{Binding CloseCommand}"
                Content="{x:Static properties:Strings.Word_Close}"
                Foreground="{Binding AppSettings.MenuForeground}"
                Grid.Column="1"
                Grid.Row="2"
                HorizontalAlignment="Left"
                Margin="10" />
    </Grid>
</Window>
