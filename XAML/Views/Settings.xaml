<Window x:Class="SylverInk.XAML.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SylverInk"
        xmlns:ctrl="clr-namespace:SylverInk.XAML.Controls"
        xmlns:properties="clr-namespace:SylverInk.Localization"
        xmlns:vm="clr-namespace:SylverInk.XAML.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Background="{Binding AppSettings.AccentBackground}"
        Loaded="Settings_Loaded"
        MinHeight="425"
        MinWidth="325"
        MouseLeftButtonDown="Drag"
        SizeToContent="Height"
        ShowInTaskbar="False"
        Title="{x:Static properties:Strings.Title_Settings}"
        Topmost="True"
        Width="325">
    <Grid Background="{Binding AppSettings.AccentBackground}"
          Margin="0,5,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        
        <TabControl Background="{Binding AppSettings.AccentBackground}"
                    BorderThickness="0"
                    Foreground="{Binding AppSettings.MenuForeground}">
            <TabItem Margin="0,0,0,-2">
                <TabItem.Header>
                    <TextBlock FontFamily="{Binding AppSettings.MainFontFamily}"
                               FontSize="{Binding AppSettings.MainFontSize}"
                               Margin="3"
                               Text="{x:Static properties:Strings.Title_Behavior}"/>
                </TabItem.Header>
                
                <Grid Background="{Binding AppSettings.MenuBackground}"
                      Margin="-2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Label FontStyle="Italic"
                           HorizontalAlignment="Right"
                           Margin="10,0">
                        <TextBlock Text="{x:Static properties:Strings.RibbonTabsDisplay}"
                                   TextAlignment="Right"
                                   TextWrapping="WrapWithOverflow"/>
                    </Label>
                    
                    <Label FontStyle="Italic"
                           HorizontalAlignment="Right"
                           Margin="10,0"
                           Grid.Row="1">
                        <TextBlock Text="{x:Static properties:Strings.RecentNotesSortBy}"
                                   TextAlignment="Right"
                                   TextWrapping="WrapWithOverflow"/>
                    </Label>

                    <Label FontStyle="Italic"
                           HorizontalAlignment="Right"
                           Margin="10,0"
                           Grid.Row="2">
                        <TextBlock Text="{x:Static properties:Strings.SearchResultsOnTop}"
                                   TextAlignment="Right"
                                   TextWrapping="WrapWithOverflow"/>
                    </Label>

                    <Label FontStyle="Italic"
                           HorizontalAlignment="Right"
                           Margin="10,0"
                           Grid.Row="3">
                        <TextBlock Text="{x:Static properties:Strings.SnapSearchResults}"
                                   TextAlignment="Right"
                                   TextWrapping="WrapWithOverflow"/>
                    </Label>

                    <Label FontStyle="Italic"
                           Foreground="{Binding AppSettings.AccentForeground}"
                           Grid.Row="4"
                           HorizontalAlignment="Right"
                           Margin="10,0"
                           ToolTip="{x:Static properties:Strings.ClickthroughTooltip}">
                        <TextBlock Text="{x:Static properties:Strings.NoteClickthrough}"
                                   TextAlignment="Right"
                                   TextDecorations="Underline"
                                   TextWrapping="WrapWithOverflow"/>
                    </Label>
                    
                    <Label FontStyle="Italic"
                           HorizontalAlignment="Right"
                           Margin="10,0"
                           Grid.Row="5">
                        <TextBlock Text="{x:Static properties:Strings.NoteTransparency}"
                                   TextAlignment="Right"
                                   TextWrapping="WrapWithOverflow"/>
                    </Label>

                    <ComboBox Grid.Column="1"
                              HorizontalAlignment="Left"
                              SelectionChanged="StickyRibbonChanged"
                              VerticalAlignment="Center"
                              Width="125"
                              x:Name="RibbonBox">
                        <ComboBoxItem Content="{x:Static properties:Strings.ContentPreview}"
                                      Tag="Content"/>
                        
                        <ComboBoxItem Content="{x:Static properties:Strings.LastChangedDate}"
                                      Tag="Change"/>
                        
                        <ComboBoxItem Content="{x:Static properties:Strings.CreatedDate}"
                                      Tag="Creation"/>
                        
                        <ComboBoxItem Content="{x:Static properties:Strings.IndexNumber}"
                                      Tag="Index"/>
                    </ComboBox>

                    <ComboBox Grid.Column="1"
                              Grid.Row="1"
                              HorizontalAlignment="Left"
                              SelectionChanged="SortRibbonChanged"
                              VerticalAlignment="Center"
                              Width="125"
                              x:Name="SortBox">
                        <ComboBoxItem Content="{x:Static properties:Strings.CreatedDate}"
                                      Tag="ByCreation"/>
                        
                        <ComboBoxItem Content="{x:Static properties:Strings.LastChangedDate}"
                                      Tag="ByChange"/>
                    </ComboBox>

                    <CheckBox Grid.Column="1"
                              HorizontalAlignment="Left"
                              IsChecked="{Binding AppSettings.SearchResultsOnTop}"
                              Margin="0,5"
                              Grid.Row="2"/>

                    <CheckBox Grid.Column="1"
                              HorizontalAlignment="Left"
                              IsChecked="{Binding AppSettings.SnapSearchResults}"
                              Margin="0,5"
                              Grid.Row="3"/>

                    <Slider Grid.Column="1"
                            Grid.Row="4"
                            HorizontalAlignment="Left"
                            IsSnapToTickEnabled="True"
                            LargeChange="1"
                            Margin="0,5"
                            Maximum="2"
                            Minimum="0"
                            SmallChange="0.25"
                            TickFrequency="0.25"
                            TickPlacement="BottomRight"
                            ToolTip="{Binding AppSettings.NoteClickthrough}"
                            ToolTipService.InitialShowDelay="250"
                            Value="{Binding AppSettings.NoteClickthrough}"
                            VerticalAlignment="Center"
                            Width="125"
                            x:Name="NoteClickthroughSlider"/>

                    <Slider Grid.Column="1"
                            Grid.Row="5"
                            HorizontalAlignment="Left"
                            IsSnapToTickEnabled="True"
                            LargeChange="10"
                            Margin="0,5"
                            Maximum="95"
                            Minimum="0"
                            SmallChange="5"
                            TickFrequency="5"
                            TickPlacement="BottomRight"
                            ToolTip="{Binding AppSettings.NoteTransparency}"
                            ToolTipService.InitialShowDelay="250"
                            Value="{Binding AppSettings.NoteTransparency}"
                            VerticalAlignment="Center"
                            Width="125"
                            x:Name="NoteTransparentSlider"/>
                </Grid>
            </TabItem>
            
            <TabItem Margin="0,0,0,-2">
                <TabItem.Header>
                    <TextBlock FontFamily="{Binding AppSettings.MainFontFamily}"
                               FontSize="{Binding AppSettings.MainFontSize}"
                               Margin="3"
                               Text="{x:Static properties:Strings.Title_Appearance}"/>
                </TabItem.Header>

                <Grid Background="{Binding AppSettings.MenuBackground}"
                      Margin="-2,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ctrl:ColorPicker x:Name="SettingsColorPicker"/>

                    <Grid Background="{Binding AppSettings.MenuBackground}"
                          Grid.ColumnSpan="2"
                          Margin="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Label Content="{x:Static properties:Strings.Label_Theme}"
                               FontStyle="Italic"
                               HorizontalAlignment="Right"
                               Margin="10,0"/>
                        
                        <Label FontStyle="Italic"
                               Foreground="{Binding AppSettings.AccentForeground}"
                               Grid.Row="1"
                               HorizontalAlignment="Right"
                               Margin="10,0"
                               ToolTip="{x:Static properties:Strings.HighContrastAssistance}">
                            <TextBlock Text="{x:Static properties:Strings.Label_SmartAssist}"
                                       TextAlignment="Right"
                                       TextDecorations="Underline"
                                       TextWrapping="WrapWithOverflow"/>
                        </Label>

                        <ComboBox Grid.Column="1"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{Binding AppSettings.ThemeCollection}"
                                  SelectedItem="{Binding AppSettings.SelectedTheme}"
                                  VerticalAlignment="Center"
                                  Width="125"
                                  x:Name="ThemeSelection"/>

                        <CheckBox Command="{Binding SmartAssistCommand}"
                                  Grid.Column="1"
                                  Grid.Row="1"
                                  HorizontalAlignment="Left"
                                  IsChecked="{Binding SmartAssistChecked}"
                                  IsEnabled="{Binding AppSettings.HighContrast}"
                                  Margin="0,10"/>
                    </Grid>

                    <Separator Grid.ColumnSpan="2"
                               Grid.Row="1"/>

                    <Grid Background="{Binding AppSettings.MenuBackground}"
                          Grid.ColumnSpan="2"
                          Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Label Content="{x:Static properties:Strings.Label_DisplayFont}"
                               FontStyle="Italic"
                               HorizontalAlignment="Right"
                               Margin="10,0"/>
                        
                        <Label Content="{x:Static properties:Strings.Label_FontSize}"
                               FontStyle="Italic"
                               Grid.Row="1"
                               HorizontalAlignment="Right"
                               Margin="10,0"/>
                        
                        <Label Content="{x:Static properties:Strings.Label_MenuColors}"
                               FontStyle="Italic"
                               Grid.Row="2"
                               HorizontalAlignment="Right"
                               Margin="10,0"/>
                        
                        <Label Content="{x:Static properties:Strings.Label_TextColors}"
                               FontStyle="Italic"
                               Grid.Row="3"
                               HorizontalAlignment="Right"
                               Margin="10,0"/>
                        
                        <Label Content="{x:Static properties:Strings.Label_AccentColors}"
                               FontStyle="Italic"
                               Grid.Row="4"
                               HorizontalAlignment="Right"
                               Margin="10,0"/>

                        <ComboBox Grid.Column="1"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{Binding AppSettings.AvailableFonts}"
                                  SelectedItem="{Binding AppSettings.MainFontFamily}"
                                  VerticalAlignment="Center"
                                  Width="125"
                                  x:Name="MenuFont">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="{Binding}"
                                               Text="{Binding}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <StackPanel Grid.Column="1"
                                    Grid.Row="1"
                                    HorizontalAlignment="Left"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Command="{Binding FontSizeChangedCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                    Content="-"
                                    MinWidth="20"/>
                            
                            <TextBox HorizontalContentAlignment="Center"
                                     IsReadOnly="True"
                                     Text="{Binding AppSettings.MainFontSize}"
                                     MinWidth="40"/>
                            
                            <Button Command="{Binding FontSizeChangedCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                    Content="+"
                                    MinWidth="20"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Grid.Row="2"
                                    HorizontalAlignment="Left"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button BorderBrush="{Binding AppSettings.AccentBackground}"
                                    BorderThickness="1"
                                    Click="ColorPopup"
                                    Height="20"
                                    Margin="20,0"
                                    MinHeight="20"
                                    MinWidth="20"
                                    Tag="P1B"
                                    Width="20">
                                <Rectangle Fill="{Binding AppSettings.MenuBackground}"
                                           Margin="-1"
                                           Stretch="UniformToFill"
                                           ToolTip="{x:Static properties:Strings.Word_Background}"/>
                            </Button>

                            <Button BorderBrush="{Binding AppSettings.AccentBackground}"
                                    BorderThickness="1"
                                    Click="ColorPopup"
                                    Height="20"
                                    Margin="20,0"
                                    MinHeight="20"
                                    MinWidth="20"
                                    Tag="P1F"
                                    Width="20">
                                <Rectangle Fill="{Binding AppSettings.MenuForeground}"
                                           Margin="-1"
                                           Stretch="UniformToFill"
                                           ToolTip="{x:Static properties:Strings.Word_Foreground}"/>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    Orientation="Horizontal"
                                    Grid.Row="3"
                                    VerticalAlignment="Center">
                            <Button BorderBrush="Black"
                                    BorderThickness="1"
                                    Click="ColorPopup"
                                    Height="20"
                                    Margin="20,0"
                                    MinHeight="20"
                                    MinWidth="20"
                                    Tag="P2B"
                                    Width="20">
                                <Rectangle Fill="{Binding AppSettings.ListBackground}"
                                           Margin="-1"
                                           Stretch="UniformToFill"
                                           ToolTip="{x:Static properties:Strings.Word_Background}"/>
                            </Button>
                            
                            <Button BorderBrush="Black"
                                    BorderThickness="1"
                                    Click="ColorPopup"
                                    Height="20"
                                    Margin="20,0"
                                    MinHeight="20"
                                    MinWidth="20"
                                    Tag="P2F"
                                    Width="20">
                                <Rectangle Fill="{Binding AppSettings.ListForeground}"
                                           Margin="-1"
                                           Stretch="UniformToFill"
                                           ToolTip="{x:Static properties:Strings.Word_Foreground}"/>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Grid.Row="4"
                                    HorizontalAlignment="Left"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button BorderBrush="Black"
                                    BorderThickness="1"
                                    Click="ColorPopup"
                                    Height="20"
                                    Margin="20,0"
                                    MinHeight="20"
                                    MinWidth="20"
                                    Tag="P3B"
                                    Width="20">
                                <Rectangle Fill="{Binding AppSettings.AccentBackground}"
                                           Margin="-1"
                                           Stretch="UniformToFill"
                                           ToolTip="{x:Static properties:Strings.Word_Background}"/>
                            </Button>
                            
                            <Button BorderBrush="Black"
                                    BorderThickness="1"
                                    Click="ColorPopup"
                                    Height="20"
                                    Margin="20,0"
                                    MinHeight="20"
                                    MinWidth="20"
                                    Tag="P3F"
                                    Width="20">
                                <Rectangle Fill="{Binding AppSettings.AccentForeground}"
                                           Margin="-1"
                                           Stretch="UniformToFill"
                                           ToolTip="{x:Static properties:Strings.Word_Foreground}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Background="{Binding AppSettings.MenuBackground}"
              Grid.ColumnSpan="2"
              Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Command="{Binding ResetCommand}"
                    Content="{x:Static properties:Strings.Word_Reset}"
                    Foreground="{Binding AppSettings.MenuForeground}"
                    HorizontalAlignment="Right"
                    Margin="10,0"/>
            
            <Button Command="{Binding CloseCommand}"
                    Content="{x:Static properties:Strings.Word_Close}"
                    Foreground="{Binding AppSettings.MenuForeground}"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    Margin="10,0"/>
        </Grid>
    </Grid>
</Window>
