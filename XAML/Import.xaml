<Window x:Class="SylverInk.XAML.Import"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:SylverInk"
		xmlns:vm="clr-namespace:SylverInk.XAML.ViewModels"
		d:DataContext="{d:DesignInstance Type=vm:ImportViewModel}"
		mc:Ignorable="d"
		Background="{Binding AppSettings.MenuBackground}" Foreground="{Binding AppSettings.MenuForeground}" Height="375" MinHeight="325" MinWidth="225" MouseLeftButtonDown="Drag" ResizeMode="CanResize" ShowInTaskbar="False" Title="Sylver Ink: Import" Topmost="True" Width="325">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<StackPanel>
			<Label Content="File to import" FontStyle="Italic" HorizontalAlignment="Right" Margin="0,20,30,0"/>
			<Grid Margin="15,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>
				<Button Command="{Binding OpenCommand}" Content="..." Height="20" HorizontalAlignment="Right" Margin="5,5,5,5" Width="20"/>
				<TextBox Grid.Column="1" IsReadOnly="True" Margin="5,5,5,5" Text="{Binding ImportTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
			</Grid>
			<Grid Margin="0,25,0,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<Button Command="{Binding ImportCommand}" Content="Import" IsEnabled="{Binding CanImport, UpdateSourceTrigger=PropertyChanged}"/>
				<Button Command="{Binding CloseCommand}" Content="Close" Grid.Column="1"/>
			</Grid>
		</StackPanel>
		
		<Grid HorizontalAlignment="Center" Margin="0,20" Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="*"/>
				<RowDefinition Height="10"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>
			<Label Content="Adaptive notes:"/>
			<CheckBox Grid.Column="1" Command="{Binding ToggleAdaptiveCommand}" IsChecked="{Binding AdaptiveImport, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
			<Label Grid.Column="2" Content="(?)" Foreground="{Binding AppSettings.AccentForeground}" ToolTip="Attempt to automatically detect boundaries between notes."/>
			<Label Content="Line tolerance:" Grid.Row="2"/>
			<StackPanel Grid.Column="1" HorizontalAlignment="Center" IsEnabled="{Binding ManualImport}" Orientation="Horizontal" Grid.Row="2">
				<Button Command="{Binding LineToleranceChangeCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}" Content="-" Width="20"/>
				<TextBox HorizontalContentAlignment="Center" IsReadOnly="True" Text="{Binding LineTolerance}" Width="20"/>
				<Button Command="{Binding LineToleranceChangeCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}" Content="+" Width="20"/>
			</StackPanel>
			<Label Grid.Column="2" Content="(?)" Foreground="{Binding AppSettings.AccentForeground}" Grid.Row="2" ToolTip="The number of blank lines to look for when separating the file into different notes."/>
		</Grid>
		<Border BorderBrush="{Binding AppSettings.MenuForeground}" BorderThickness="1" Grid.Row="2" Margin="20,5,20,20">
			<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
				<TextBlock Background="{Binding AppSettings.ListBackground}" FontFamily="{Binding AppSettings.MainFontFamily}" FontSize="{Binding AppSettings.MainFontSize}" Foreground="{Binding AppSettings.ListForeground}"
						   Text="{Binding StatusText}" TextWrapping="WrapWithOverflow"/>
			</ScrollViewer>
		</Border>
	</Grid>
</Window>
