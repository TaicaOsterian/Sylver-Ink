<Window x:Class="SylverInk.XAML.SearchResult"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SylverInk"
        xmlns:properties="clr-namespace:SylverInk.Localization"
        xmlns:utils="clr-namespace:SylverInk.XAMLUtils"
        xmlns:vm="clr-namespace:SylverInk.XAML.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SearchResultViewModel}"
        Activated="WindowActivated" AllowsTransparency="True"
        Background="{x:Null}" Closed="Result_Closed" Deactivated="WindowDeactivated" Height="225" Loaded="WindowLoaded" MinHeight="125" MinWidth="175" MouseDown="WindowMouseDown" MouseEnter="WindowMouseEnter" MouseLeave="WindowMouseLeave" MouseMove="WindowMove" MouseUp="WindowMouseUp" ResizeMode="CanResizeWithGrip" ShowInTaskbar="{Binding AppSettings.SearchResultsInTaskbar}" Title="{x:Static properties:Strings.Title_StickyNote}" Topmost="{Binding AppSettings.SearchResultsOnTop}" Width="225" WindowStyle="None">
    <Border Background="{Binding AppSettings.MenuBackground}" BorderBrush="{Binding AppSettings.AccentBackground}" BorderThickness="1.5" CornerRadius="6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <RichTextBox AcceptsReturn="True"
                         utils:RichTextBoxUtils.BoundCaret="{Binding CaretPosition, Mode=TwoWay}"
                         Grid.ColumnSpan="2"
                         utils:RichTextBoxUtils.Document="{Binding Document, Mode=TwoWay}"
                         Height="Auto"
                         IsEnabled="{Binding IsEnabled}"
                         Margin="5,5,5,0"
                         utils:RichTextBoxUtils.ObserveCaret="True"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         TextChanged="ResultBlock_TextChanged"
                         UndoLimit="20">
            </RichTextBox>
            <Label Content="{Binding LastChange}" Grid.ColumnSpan="2" FontStyle="Italic" HorizontalAlignment="Center" Grid.Row="1"/>
            <Button Command="{Binding ViewCommand}" Content="{Binding Source={x:Static properties:Strings.Word_View}, StringFormat='{}{0}...'}" IsEnabled="{Binding IsFocused}" Margin="0,2" Grid.Row="2" Width="50"/>
            <Button Command="{Binding CloseCommand}" Grid.Column="1" Content="{x:Static properties:Strings.Word_Close}" IsEnabled="{Binding IsFocused}" Margin="0,2" Grid.Row="2" Width="50"/>
        </Grid>
    </Border>
</Window>
