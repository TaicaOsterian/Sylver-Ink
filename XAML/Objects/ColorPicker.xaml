<UserControl x:Class="SylverInk.XAML.Objects.ColorPicker"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
			 xmlns:local="clr-namespace:SylverInk.XAML.Objects"
			 xmlns:sylverink="clr-namespace:SylverInk"
			 xmlns:vm="clr-namespace:SylverInk.XAML.Objects.ViewModels"
			 mc:Ignorable="d"
			 d:DataContext="{d:DesignInstance Type=vm:ColorPickerViewModel}">
	<Grid>
		<local:CustomColorPicker x:Name="CustomColorPicker"/>
		<Popup Focusable="True" Height="400" IsOpen="False" KeyDown="PopupKeyDown" Placement="Mouse" PopupAnimation="Fade" StaysOpen="False" Width="265" x:Name="ColorSelection">
			<Border BorderBrush="{Binding AppSettings.MenuForeground}" BorderThickness="1">
				<Grid Background="{Binding AppSettings.MenuBackground}" x:Name="ColorGrid"/>
			</Border>
		</Popup>
	</Grid>
</UserControl>
