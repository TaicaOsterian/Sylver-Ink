<UserControl x:Class="SylverInk.XAML.Objects.NoteTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SylverInk.XAML.Objects"
             xmlns:properties="clr-namespace:SylverInk.Localization"
             xmlns:sylverink="clr-namespace:SylverInk"
             xmlns:utils="clr-namespace:SylverInk.XAMLUtils"
             xmlns:vm="clr-namespace:SylverInk.XAML.Objects.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:NoteTabViewModel}"
             KeyDown="NoteTab_KeyDown"
             Loaded="NoteTab_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="ToolbarButton" TargetType="Button">
                <Setter Property="Background" Value="{Binding AppSettings.ListBackground}"/>
                <Setter Property="CommandTarget" Value="{Binding ElementName=NoteBox}"/>
                <Setter Property="Foreground" Value="{Binding AppSettings.ListForeground}"/>
                <Setter Property="Width" Value="35"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="2" x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label Content="{Binding LastChange}" FontStyle="Italic" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Bottom" x:Name="RevisionLabel"/>
        <Grid Grid.Row="1" HorizontalAlignment="Center" x:Name="NoteToolbar">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Separator Grid.ColumnSpan="8" Foreground="{Binding AppSettings.AccentForeground}" Height="2" Grid.Row="1"/>
            <Button Style="{StaticResource ToolbarButton}" Command="ApplicationCommands.Undo" Content="↶" TabIndex="0" ToolTip="{x:Static properties:Strings.Word_Undo}" ToolTipService.ShowOnDisabled="True"/>
            <Button Style="{StaticResource ToolbarButton}" Command="ApplicationCommands.Redo" Content="↷" Grid.Column="1" TabIndex="1" ToolTip="{x:Static properties:Strings.Word_Redo}" ToolTipService.ShowOnDisabled="True"/>
            <Button Style="{StaticResource ToolbarButton}" Command="EditingCommands.ToggleBold" Grid.Column="2" TabIndex="2" ToolTip="{x:Static properties:Strings.Word_Bold}">
                <TextBlock FontWeight="Bold">B</TextBlock>
            </Button>
            <Button Style="{StaticResource ToolbarButton}" Command="EditingCommands.ToggleItalic" Grid.Column="3" TabIndex="3" ToolTip="{x:Static properties:Strings.Word_Italic}">
                <TextBlock FontStyle="Italic" FontWeight="Bold">I</TextBlock>
            </Button>
            <Button Style="{StaticResource ToolbarButton}" Command="EditingCommands.ToggleUnderline" Grid.Column="4" TabIndex="4" ToolTip="{x:Static properties:Strings.Word_Underline}">
                <TextBlock TextDecorations="Underline" FontWeight="Bold">U</TextBlock>
            </Button>
            <Button Style="{StaticResource ToolbarButton}" Command="EditingCommands.IncreaseFontSize" Grid.Column="5" TabIndex="9" ToolTip="{x:Static properties:Strings.IncreaseFontSize}">
                <TextBlock FontWeight="Bold">A↑</TextBlock>
            </Button>
            <Button Style="{StaticResource ToolbarButton}" Command="EditingCommands.DecreaseFontSize" Grid.Column="6" TabIndex="10" ToolTip="{x:Static properties:Strings.DecreaseFontSize}">
                <TextBlock FontWeight="Bold">a↓</TextBlock>
            </Button>
            <Button Style="{StaticResource ToolbarButton}" Click="SelectColor" Grid.Column="7" TabIndex="11" ToolTip="{x:Static properties:Strings.Label_TextColor}" x:Name="TextColorButton">
                <Path Fill="Black" Stroke="White" StrokeThickness="0.5" Data="M13.354.646a1.207 1.207 0 0 0-1.708 0L8.5 3.793l-.646-.647a.5.5 0 1 0-.708.708L8.293 5l-7.147 7.146A.5.5 0 0 0 1 12.5v1.793l-.854.853a.5.5 0 1 0 .708.707L1.707 15H3.5a.5.5 0 0 0 .354-.146L11 7.707l1.146 1.147a.5.5 0 0 0 .708-.708l-.647-.646 3.147-3.146a1.207 1.207 0 0 0 0-1.708zM2 12.707l7-7L10.293 7l-7 7H2z"/>
            </Button>
            <Button Style="{StaticResource ToolbarButton}" Command="EditingCommands.AlignLeft" Grid.Row="2" Grid.Column="1" TabIndex="5" ToolTip="{x:Static properties:Strings.Word_Left}">
                <StackPanel>
                    <Line Stroke="{Binding AppSettings.ListForeground}" StrokeThickness="1" X1="0" X2="16" Y1="2" Y2="2"/>
                    <Line Stroke="{Binding AppSettings.ListForeground}" StrokeThickness="1" X1="0" X2="8" Y1="3" Y2="3"/>
                    <Line Stroke="{Binding AppSettings.ListForeground}" StrokeThickness="1" X1="0" X2="12" Y1="3" Y2="3"/>
                    <Line Stroke="{Binding AppSettings.ListForeground}" StrokeThickness="1" X1="0" X2="8" Y1="3" Y2="3"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarButton}" Command="EditingCommands.AlignCenter" Grid.Row="2" Grid.Column="2" TabIndex="6" ToolTip="{x:Static properties:Strings.Word_Center}">
                <StackPanel>
                    <Line Stroke="{Binding AppSettings.ListForeground}" StrokeThickness="1" X1="0" X2="16" Y1="2" Y2="2"/>
                    <Line Stroke="{Binding AppSettings.ListForeground}" StrokeThickness="1" X1="4" X2="12" Y1="3" Y2="3"/>
                    <Line Stroke="{Binding AppSettings.ListForeground}" StrokeThickness="1" X1="2" X2="14" Y1="3" Y2="3"/>
                    <Line Stroke="{Binding AppSettings.ListForeground}" StrokeThickness="1" X1="4" X2="12" Y1="3" Y2="3"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarButton}" Command="EditingCommands.AlignRight" Grid.Row="2" Grid.Column="3" TabIndex="7" ToolTip="{x:Static properties:Strings.Word_Right}">
                <StackPanel>
                    <Line Stroke="{Binding AppSettings.ListForeground}" StrokeThickness="1" X1="0" X2="16" Y1="2" Y2="2"/>
                    <Line Stroke="{Binding AppSettings.ListForeground}" StrokeThickness="1" X1="8" X2="16" Y1="3" Y2="3"/>
                    <Line Stroke="{Binding AppSettings.ListForeground}" StrokeThickness="1" X1="4" X2="16" Y1="3" Y2="3"/>
                    <Line Stroke="{Binding AppSettings.ListForeground}" StrokeThickness="1" X1="8" X2="16" Y1="3" Y2="3"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarButton}" Command="EditingCommands.AlignJustify" Grid.Row="2" Grid.Column="4" TabIndex="8" ToolTip="{x:Static properties:Strings.Word_Justify}">
                <StackPanel>
                    <Line Stroke="{Binding AppSettings.ListForeground}" StrokeThickness="1" X1="0" X2="16" Y1="2" Y2="2"/>
                    <Line Stroke="{Binding AppSettings.ListForeground}" StrokeThickness="1" X1="0" X2="16" Y1="3" Y2="3"/>
                    <Line Stroke="{Binding AppSettings.ListForeground}" StrokeThickness="1" X1="0" X2="16" Y1="3" Y2="3"/>
                    <Line Stroke="{Binding AppSettings.ListForeground}" StrokeThickness="1" X1="0" X2="16" Y1="3" Y2="3"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarButton}" Command="EditingCommands.ToggleBullets" Grid.Row="2" Grid.Column="5" ToolTip="{x:Static properties:Strings.BulletList}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Fill="{Binding AppSettings.ListForeground}" Height="4" HorizontalAlignment="Left" Width="4"/>
                        <Line Stroke="{Binding AppSettings.ListForeground}" StrokeThickness="1" X1="2" X2="16" Y1="1.5" Y2="1.5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Fill="{Binding AppSettings.ListForeground}" Height="4" HorizontalAlignment="Left" Width="4"/>
                        <Line Stroke="{Binding AppSettings.ListForeground}" StrokeThickness="1" X1="2" X2="16" Y1="1.5" Y2="1.5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Fill="{Binding AppSettings.ListForeground}" Height="4" HorizontalAlignment="Left" Width="4"/>
                        <Line Stroke="{Binding AppSettings.ListForeground}" StrokeThickness="1" X1="2" X2="16" Y1="1.5" Y2="1.5"/>
                    </StackPanel>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarButton}" Command="EditingCommands.ToggleNumbering" Grid.Row="2" Grid.Column="6" ToolTip="{x:Static properties:Strings.NumberedList}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Arial" FontSize="4" FontWeight="Bold" Text="1"/>
                        <Line Stroke="{Binding AppSettings.ListForeground}" StrokeThickness="1" X1="2" X2="16" Y1="2" Y2="2"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Arial" FontSize="4" FontWeight="Bold" Text="2"/>
                        <Line Stroke="{Binding AppSettings.ListForeground}" StrokeThickness="1" X1="2" X2="16" Y1="2" Y2="2"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Arial" FontSize="4" FontWeight="Bold" Text="3"/>
                        <Line Stroke="{Binding AppSettings.ListForeground}" StrokeThickness="1" X1="2" X2="16" Y1="2" Y2="2"/>
                    </StackPanel>
                </StackPanel>
            </Button>
        </Grid>

        <local:ColorPicker x:Name="TextColorPicker"/>

        <Popup Focusable="True" Height="75" IsOpen="False" StaysOpen="True" Width="300" x:Name="InternalSearchPopup">
            <Border BorderBrush="{Binding AppSettings.MenuForeground}" BorderThickness="1">
                <Grid Background="{Binding AppSettings.MenuBackground}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Label Content="{x:Static properties:Strings.Word_Search}"/>
                    <TextBox Grid.Column="1" Grid.ColumnSpan="3" KeyDown="ISPText_KeyDown" Text="{Binding SearchText}" Width="200" x:Name="ISPText"/>
                    <Button Command="{Binding FindPreviousCommand}" Content="{x:Static properties:Strings.Label_Previous}" Grid.ColumnSpan="2" Grid.Row="1"/>
                    <Button Command="{Binding FindNextCommand}" Content="{x:Static properties:Strings.Label_Next}" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"/>
                    <Button Command="{Binding CloseSearchPopupCommand}" Content="{x:Static properties:Strings.Word_Close}" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="1"/>
                </Grid>
            </Border>
        </Popup>

        <RichTextBox AcceptsReturn="True"
                     IsInactiveSelectionHighlightEnabled="True"
                     utils:RichTextBoxUtils.BoundCaret="{Binding CaretPosition, Mode=TwoWay}"
                     utils:RichTextBoxUtils.Document="{Binding Document, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     utils:RichTextBoxUtils.ObserveCaret="True"
                     Grid.Row="2"
                     SelectionChanged="NoteBox_SelectionChanged"
                     TabIndex="12"
                     TextChanged="NoteBox_TextChanged"
                     UndoLimit="10"
                     VerticalScrollBarVisibility="Auto"
                     x:Name="NoteBox"/>

        <Grid HorizontalAlignment="Center" Margin="0,20" Grid.Row="3" x:Name="ButtonGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button Command="{Binding NavigatePreviousCommand}" Grid.ColumnSpan="2" Content="←" IsEnabled="{Binding CanNavigatePrevious}" TabIndex="13" Width="50" x:Name="PreviousButton"/>
            <Button Command="{Binding NavigateNextCommand}" Grid.Column="1" Grid.ColumnSpan="2" Content="→" IsEnabled="{Binding CanNavigateNext}" TabIndex="14" Width="50" x:Name="NextButton"/>

            <Button Command="{Binding DeleteCommand}" Content="{x:Static properties:Strings.Word_Delete}" Grid.Row="2" TabIndex="15" x:Name="DeleteButton"/>
            <Button Command="{Binding SaveCommand}" Grid.Column="1" Content="{Binding SaveLabel}" IsEnabled="{Binding Edited}" Margin="20,0" Grid.Row="2" TabIndex="16" x:Name="SaveButton"/>
            <Button Command="{Binding ReturnCommand}" Grid.Column="2" Content="{x:Static properties:Strings.Word_Return}" Grid.Row="2" TabIndex="17" x:Name="ReturnButton"/>
        </Grid>
    </Grid>
</UserControl>