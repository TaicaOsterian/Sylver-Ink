<UserControl x:Class="SylverInk.XAML.Controls.DatabaseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:SylverInk.Mvvm.Converters"
             xmlns:local="clr-namespace:SylverInk.XAML.Controls"
             xmlns:properties="clr-namespace:SylverInk.Localization"
             xmlns:sylverink="clr-namespace:SylverInk"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:DatabaseControlViewModel}">
    <UserControl.Resources>
        <Style TargetType="{x:Type Button}" x:Key="NoteToolbarButtonStyle">
            <Setter Property="Background" Value="{Binding AppSettings.ListBackground}"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="{Binding AppSettings.ListForeground}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                x:Name="Border">
                            <ContentPresenter HorizontalAlignment="Center"
                                              Margin="3"
                                              VerticalAlignment="Center"/>
                        </Border>
                        
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{Binding AppSettings.DisabledBackground}"/>
                                <Setter Property="Foreground" Value="{Binding AppSettings.DisabledForeground}"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{Binding AppSettings.AccentBackground}"/>
                                <Setter Property="Foreground" Value="{Binding AppSettings.AccentForeground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <TabControl Background="{Binding AppSettings.MenuBackground}"
                BorderBrush="{Binding AppSettings.AccentBackground}"
                BorderThickness="2"
                Foreground="{Binding AppSettings.MenuForeground}"
                Grid.Row="1"
                Margin="-3,0"
                SelectedIndex="0"
                SelectionChanged="Controller_SelectionChanged"
                x:Name="Controller">
        <TabItem x:Name="PlusTab" Margin="0,2,0,0">
            <TabItem.Header>
                <Grid Margin="0,-4,0,0">
                    <Label Content="+"/>
                </Grid>
            </TabItem.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Command="{Binding NewNoteCommand}"
                                Style="{StaticResource NoteToolbarButtonStyle}"
                                ToolTip="{x:Static properties:Strings.NewNoteButtonTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Height="16" Margin="0,0,3,0" Stretch="Uniform" Width="Auto">
                                    <Canvas Height="18" Width="14">
                                        <Path Data="M0 18L0 0L11 0L14 3L14 18ZM11 0L11 3L14 3"
                                              Fill="{Binding AppSettings.ListBackground}"
                                              Stroke="{Binding AppSettings.ListForeground}"
                                              StrokeThickness="1.25"/>
                                        
                                        <Path Data="M3 12L11 12M7 8L7 16"
                                              Stroke="{Binding AppSettings.AccentForeground}"
                                              StrokeThickness="1.5"/>
                                    </Canvas>
                                </Viewbox>

                                <TextBlock FontSize="{Binding AppSettings.SmallFontSize}"
                                           Text="{x:Static properties:Strings.Word_New}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ReopenNoteCommand}"
                                Grid.Column="1"
                                Style="{StaticResource NoteToolbarButtonStyle}"
                                ToolTip="{x:Static properties:Strings.RecentNotesButtonTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Height="16" Margin="0,0,3,0" Stretch="Uniform" Width="Auto">
                                    <Canvas Height="18" Width="14">
                                        <Path Data="M0 18L0 0L11 0L14 3L14 18ZM11 0L11 3L14 3"
                                              Fill="{Binding AppSettings.ListBackground}"
                                              Stroke="{Binding AppSettings.ListForeground}"
                                              StrokeThickness="1.25"/>

                                        <Path Data="M10 16 V10 H3.5M6 7 L3.5 10 L6 13"
                                              Stroke="{Binding AppSettings.AccentForeground}"
                                              StrokeThickness="1.5"/>
                                    </Canvas>
                                </Viewbox>

                                <TextBlock FontSize="{Binding AppSettings.SmallFontSize}"
                                           Text="{x:Static properties:Strings.Word_Restore}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SearchCommand}"
                                Grid.Column="2"
                                Style="{StaticResource NoteToolbarButtonStyle}"
                                ToolTip="{x:Static properties:Strings.Tooltip_SearchButton}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Height="16" Margin="0,0,3,0" Stretch="Uniform" Width="Auto">
                                    <Canvas Height="24" Width="24">
                                        <Path Data="m 13.8,13.65 a 7.785,7.75 0 1 0 -0.1,0.1 l 8.65,8.6 m -4.65,-5.925 5.6,5.575 -1.325,1.325 -5.6,-5.575"
                                              Fill="{Binding AppSettings.ListBackground}"
                                              Stroke="{Binding AppSettings.ListForeground}"
                                              StrokeThickness="1.25"/>
                                    </Canvas>
                                </Viewbox>

                                <TextBlock FontSize="{Binding AppSettings.SmallFontSize}"
                                           Text="{x:Static properties:Strings.Word_Search}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom">
                        <Label FontStyle="Italic">
                            <TextBlock Text="{x:Static properties:Strings.RecentNotes}"
                                       TextWrapping="WrapWithOverflow"/>
                        </Label>
                        
                        <Label Foreground="{Binding AppSettings.AccentForeground}"
                               ToolTip="{x:Static properties:Strings.RecentNotesTooltip}">
                            <TextBlock Text="(?)" TextDecorations="Underline"/>
                        </Label>
                    </StackPanel>

                    <Border BorderBrush="{Binding AppSettings.AccentBackground}"
                            BorderThickness="1"
                            Grid.ColumnSpan="2"
                            Grid.Row="1">
                        <Grid Background="{Binding AppSettings.AccentBackground}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ListBox AlternationCount="2"
                                     BorderThickness="0"
                                     ClipToBounds="True"
                                     ItemsSource="{Binding AppSettings.RecentNotes}"
                                     Margin="0,0,1,0"
                                     MinWidth="60"
                                     MouseUp="ListItemChosen"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     x:Name="ShortChangesBox"
                                     Visibility="{Binding AppSettings.GridEnabled, Converter={StaticResource BoolToVis}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Right"
                                                   Text="{Binding ShortChange}"
                                                   ToolTip="{Binding FullDateChange}"
                                                   ToolTipService.InitialShowDelay="250"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <ListBox AlternationCount="2"
                                     BorderThickness="0"
                                     ClipToBounds="True"
                                     Grid.Column="1"
                                     ItemsSource="{Binding AppSettings.RecentNotes}"
                                     Margin="1,0,0,0"
                                     MouseUp="ListItemChosen"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     x:Name="RecentNotesBox"
                                     Visibility="{Binding AppSettings.GridEnabled, Converter={StaticResource BoolToVis}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock ClipToBounds="True"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding Preview}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Margin="0,10" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Command="{Binding SettingsCommand}"
                            Grid.Column="1"
                            Content="{x:Static properties:Strings.Word_Settings}"
                            Margin="0,5"/>
                    
                    <Button Command="{Binding ExitCommand}"
                            Grid.Column="3"
                            Content="{x:Static properties:Strings.Word_Exit}"
                            Foreground="{Binding AppSettings.AccentForeground}"
                            Margin="0,5"/>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
