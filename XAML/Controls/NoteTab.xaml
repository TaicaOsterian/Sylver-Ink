<UserControl x:Class="SylverInk.XAML.Controls.NoteTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SylverInk.XAML.Controls"
             xmlns:conv="clr-namespace:SylverInk.Mvvm.Converters"
             xmlns:properties="clr-namespace:SylverInk.Localization"
             xmlns:sylverink="clr-namespace:SylverInk"
             xmlns:utils="clr-namespace:SylverInk.XAMLUtils"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:NoteTabViewModel}"
             KeyDown="NoteTab_KeyDown"
             Loaded="NoteTab_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="ToolbarButton" TargetType="Button">
                <Setter Property="Background" Value="{Binding AppSettings.ListBackground}"/>
                <Setter Property="CommandTarget" Value="{Binding ElementName=NoteBox}"/>
                <Setter Property="Foreground" Value="{Binding AppSettings.ListForeground}"/>
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="MinHeight" Value="20"/>
                <Setter Property="MinWidth" Value="35"/>
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{Binding AppSettings.MenuForeground}"
                                    BorderThickness="1"
                                    x:Name="Border">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="{Binding AppSettings.DisabledBackground}"/>
                                    <Setter Property="Foreground" Value="{Binding AppSettings.DisabledForeground}"/>
                                </Trigger>

                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{Binding AppSettings.AccentBackground}"/>
                                    <Setter Property="Foreground" Value="{Binding AppSettings.AccentForeground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="2" x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Content="{Binding LastChange}"
               FontStyle="Italic"
               HorizontalAlignment="Right"
               Margin="0,0,10,0"
               VerticalAlignment="Bottom"
               x:Name="RevisionLabel"/>

        <Grid Grid.Row="1"
              HorizontalAlignment="Center"
              x:Name="NoteToolbar">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Command="ApplicationCommands.Undo"
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="{x:Static properties:Strings.Word_Undo}"
                    ToolTipService.ShowOnDisabled="True">
                <Path Data="M 12.5 1 c -2.65 0 -5.05 0.99 -7 2.5 L 2 0 v 9 h 9 l -3.75 -3.75 c 1.5 -1.25 3.25 -2 5.25 -2 3.5 0 6.5 2.25 7.5 5.5 l 2.25 -0.75 C 19 1.5 15.5 1 12.5 1 z"
                      Fill="{Binding AppSettings.ListBackground}"
                      Stroke="{Binding AppSettings.ListForeground}"
                      StrokeThickness="1"/>
            </Button>

            <Button Command="ApplicationCommands.Redo"
                    Grid.Column="1"
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="{x:Static properties:Strings.Word_Redo}"
                    ToolTipService.ShowOnDisabled="True">
                <Path Data="M 11.5 1 c 2.65 0 5.05 0.99 7 2.5 L 22 0 v 9 h -9 l 3.75 -3.75 c -1.5 -1.25 -3.25 -2 -5.25 -2 -3.5 0 -6.5 2.25 -7.5 5.5 l -2.25 -0.75 C 5 1.5 8.5 1 11.5 1 z"
                      Fill="{Binding AppSettings.ListBackground}"
                      Stroke="{Binding AppSettings.ListForeground}"
                      StrokeThickness="1"/>
            </Button>

            <Button Command="EditingCommands.ToggleBold"
                    Grid.Column="2"
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="{x:Static properties:Strings.Word_Bold}">
                <TextBlock FontWeight="Bold">B</TextBlock>
            </Button>

            <Button Command="EditingCommands.ToggleItalic"
                    Grid.Column="3"
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="{x:Static properties:Strings.Word_Italic}">
                <TextBlock FontStyle="Italic" FontWeight="Bold">I</TextBlock>
            </Button>

            <Button Command="EditingCommands.ToggleUnderline"
                    Grid.Column="4"
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="{x:Static properties:Strings.Word_Underline}">
                <TextBlock TextDecorations="Underline" FontWeight="Bold">U</TextBlock>
            </Button>

            <Button Command="EditingCommands.IncreaseFontSize"
                    Grid.Column="5"
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="{x:Static properties:Strings.IncreaseFontSize}">
                <TextBlock FontWeight="Bold">A↑</TextBlock>
            </Button>

            <Button Command="EditingCommands.DecreaseFontSize"
                    Grid.Column="6"
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="{x:Static properties:Strings.DecreaseFontSize}">
                <TextBlock FontWeight="Bold">a↓</TextBlock>
            </Button>

            <Button Click="SelectColor"
                    Grid.Column="7"
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="{x:Static properties:Strings.Label_TextColor}"
            x:Name="TextColorButton">
                <Path Data="M13.354.646a1.207 1.207 0 0 0-1.708 0L8.5 3.793l-.646-.647a.5.5 0 1 0-.708.708L8.293 5l-7.147 7.146A.5.5 0 0 0 1 12.5v1.793l-.854.853a.5.5 0 1 0 .708.707L1.707 15H3.5a.5.5 0 0 0 .354-.146L11 7.707l1.146 1.147a.5.5 0 0 0 .708-.708l-.647-.646 3.147-3.146a1.207 1.207 0 0 0 0-1.708zM2 12.707l7-7L10.293 7l-7 7H2z"
                      Fill="Black"
                      Stroke="White"
                      StrokeThickness="0.5"/>
            </Button>

            <Separator Grid.ColumnSpan="8"
                       Grid.Row="1"
                       Foreground="{Binding AppSettings.AccentForeground}"
                       Height="2"/>

            <Button Command="EditingCommands.AlignLeft"
                    Grid.Column="1"
                    Grid.Row="2"
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="{x:Static properties:Strings.Word_Left}">
                <StackPanel>
                    <Line Stroke="{Binding AppSettings.ListForeground}"
                          StrokeThickness="1"
                          X1="0"
                          X2="16"
                          Y1="3"
                          Y2="3"/>

                    <Line Stroke="{Binding AppSettings.ListForeground}"
                          StrokeThickness="1"
                          X1="0"
                          X2="8"
                          Y1="3"
                          Y2="3"/>

                    <Line Stroke="{Binding AppSettings.ListForeground}"
                          StrokeThickness="1"
                          X1="0"
                          X2="12"
                          Y1="3"
                          Y2="3"/>

                    <Line Stroke="{Binding AppSettings.ListForeground}"
                          StrokeThickness="1"
                          X1="0"
                          X2="8"
                          Y1="3"
                          Y2="3"/>
                </StackPanel>
            </Button>

            <Button Command="EditingCommands.AlignCenter"
                    Grid.Column="2"
                    Grid.Row="2"
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="{x:Static properties:Strings.Word_Center}">
                <StackPanel>
                    <Line Stroke="{Binding AppSettings.ListForeground}"
                          StrokeThickness="1"
                          X1="0"
                          X2="16"
                          Y1="3"
                          Y2="3"/>

                    <Line Stroke="{Binding AppSettings.ListForeground}"
                          StrokeThickness="1"
                          X1="4"
                          X2="12"
                          Y1="3"
                          Y2="3"/>

                    <Line Stroke="{Binding AppSettings.ListForeground}"
                          StrokeThickness="1"
                          X1="2"
                          X2="14"
                          Y1="3"
                          Y2="3"/>

                    <Line Stroke="{Binding AppSettings.ListForeground}"
                          StrokeThickness="1"
                          X1="4"
                          X2="12"
                          Y1="3"
                          Y2="3"/>
                </StackPanel>
            </Button>

            <Button Command="EditingCommands.AlignRight"
                    Grid.Column="3"
                    Grid.Row="2"
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="{x:Static properties:Strings.Word_Right}">
                <StackPanel>
                    <Line Stroke="{Binding AppSettings.ListForeground}"
                          StrokeThickness="1"
                          X1="0"
                          X2="16"
                          Y1="3"
                          Y2="3"/>

                    <Line Stroke="{Binding AppSettings.ListForeground}"
                          StrokeThickness="1"
                          X1="8"
                          X2="16"
                          Y1="3"
                          Y2="3"/>

                    <Line Stroke="{Binding AppSettings.ListForeground}"
                          StrokeThickness="1"
                          X1="4"
                          X2="16"
                          Y1="3"
                          Y2="3"/>

                    <Line Stroke="{Binding AppSettings.ListForeground}"
                          StrokeThickness="1"
                          X1="8"
                          X2="16"
                          Y1="3"
                          Y2="3"/>
                </StackPanel>
            </Button>

            <Button Command="EditingCommands.AlignJustify"
                    Grid.Column="4"
                    Grid.Row="2"
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="{x:Static properties:Strings.Word_Justify}">
                <StackPanel>
                    <Line Stroke="{Binding AppSettings.ListForeground}"
                          StrokeThickness="1"
                          X1="0"
                          X2="16"
                          Y1="3"
                          Y2="3"/>

                    <Line Stroke="{Binding AppSettings.ListForeground}"
                          StrokeThickness="1"
                          X1="0"
                          X2="16"
                          Y1="3"
                          Y2="3"/>

                    <Line Stroke="{Binding AppSettings.ListForeground}"
                          StrokeThickness="1"
                          X1="0"
                          X2="16"
                          Y1="3"
                          Y2="3"/>

                    <Line Stroke="{Binding AppSettings.ListForeground}"
                          StrokeThickness="1"
                          X1="0"
                          X2="16"
                          Y1="3"
                          Y2="3"/>
                </StackPanel>
            </Button>

            <Button Command="EditingCommands.ToggleBullets"
                    Grid.Column="5"
                    Grid.Row="2"
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="{x:Static properties:Strings.BulletList}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Fill="{Binding AppSettings.ListForeground}"
                                 Height="4"
                                 HorizontalAlignment="Left"
                                 Width="4"/>

                        <Line Stroke="{Binding AppSettings.ListForeground}"
                              StrokeThickness="1"
                              X1="2"
                              X2="16"
                              Y1="1.5"
                              Y2="1.5"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Ellipse Fill="{Binding AppSettings.ListForeground}"
                                 Height="4"
                                 HorizontalAlignment="Left"
                                 Width="4"/>

                        <Line Stroke="{Binding AppSettings.ListForeground}"
                              StrokeThickness="1"
                              X1="2"
                              X2="16"
                              Y1="1.5"
                              Y2="1.5"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Ellipse Fill="{Binding AppSettings.ListForeground}"
                                 Height="4"
                                 HorizontalAlignment="Left"
                                 Width="4"/>

                        <Line Stroke="{Binding AppSettings.ListForeground}"
                              StrokeThickness="1"
                              X1="2"
                              X2="16"
                              Y1="1.5"
                              Y2="1.5"/>
                    </StackPanel>
                </StackPanel>
            </Button>
            
            <Button Command="EditingCommands.ToggleNumbering"
                    Grid.Row="2"
                    Grid.Column="6"
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="{x:Static properties:Strings.NumberedList}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="4"
                                   FontWeight="Bold"
                                   Text="1"/>

                        <Line Stroke="{Binding AppSettings.ListForeground}"
                              StrokeThickness="1"
                              X1="2"
                              X2="16"
                              Y1="2"
                              Y2="2"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="4"
                                   FontWeight="Bold"
                                   Text="2"/>

                        <Line Stroke="{Binding AppSettings.ListForeground}"
                              StrokeThickness="1"
                              X1="2"
                              X2="16"
                              Y1="2"
                              Y2="2"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="4"
                                   FontWeight="Bold"
                                   Text="3"/>

                        <Line Stroke="{Binding AppSettings.ListForeground}"
                              StrokeThickness="1"
                              X1="2"
                              X2="16"
                              Y1="2"
                              Y2="2"/>
                    </StackPanel>
                </StackPanel>
            </Button>
        </Grid>

        <local:ColorPicker x:Name="TextColorPicker"/>

        <Popup Focusable="True"
               Height="75"
               IsOpen="False"
               StaysOpen="True"
               Width="300"
               x:Name="InternalSearchPopup">
            <Border BorderBrush="{Binding AppSettings.MenuForeground}"
                    BorderThickness="1">
                <Grid Background="{Binding AppSettings.MenuBackground}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Label Content="{x:Static properties:Strings.Word_Search}"/>

                    <TextBox Grid.Column="1"
                             Grid.ColumnSpan="3"
                             KeyDown="ISPText_KeyDown"
                             Text="{Binding SearchText}"
                             Width="200"
                             x:Name="ISPText"/>

                    <Button Command="{Binding FindPreviousCommand}"
                            Content="{x:Static properties:Strings.Label_Previous}"
                            Grid.ColumnSpan="2"
                            Grid.Row="1"/>

                    <Button Command="{Binding FindNextCommand}"
                            Content="{x:Static properties:Strings.Label_Next}"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Grid.Row="1"/>

                    <Button Command="{Binding CloseSearchPopupCommand}"
                            Content="{x:Static properties:Strings.Word_Close}"
                            Grid.Column="2"
                            Grid.ColumnSpan="2"
                            Grid.Row="1"/>
                </Grid>
            </Border>
        </Popup>

        <RichTextBox utils:RichTextBoxUtils.BoundCaret="{Binding CaretPosition, Mode=TwoWay}"
                     utils:RichTextBoxUtils.Document="{Binding Document, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Focusable="{Binding IsLive, Converter={StaticResource BoolToVis}}"
                     Grid.Row="2"
                     IsInactiveSelectionHighlightEnabled="True"
                     utils:RichTextBoxUtils.ObserveCaret="True"
                     SelectionChanged="NoteBox_SelectionChanged"
                     TextChanged="NoteBox_TextChanged"
                     Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}"
                     x:Name="NoteBox">
            <RichTextBox.CommandBindings>
                <CommandBinding Command="ApplicationCommands.Undo" 
                        CanExecute="CanUndo" 
                        Executed="Undo"/>

                <CommandBinding Command="ApplicationCommands.Redo" 
                        CanExecute="CanRedo" 
                        Executed="Redo"/>
            </RichTextBox.CommandBindings>
        </RichTextBox>

        <RichTextBox utils:RichTextBoxUtils.Document="{Binding HistoricalDocument, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Focusable="False"
                     Grid.Row="2"
                     IsReadOnly="True"
                     Visibility="{Binding IsLive, Converter={StaticResource InvBoolToVis}}"
                     x:Name="RevisionBox"/>

        <Grid HorizontalAlignment="Center"
              Margin="0,20"
              Grid.Row="3"
              x:Name="ButtonGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button Command="{Binding NavigatePreviousCommand}"
                    Content="←"
                    Grid.ColumnSpan="2"
                    MinWidth="50"
                    x:Name="PreviousButton"/>

            <Button Command="{Binding NavigateNextCommand}"
                    Content="→"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    MinWidth="50"
                    x:Name="NextButton"/>

            <Button Command="{Binding DeleteCommand}"
                    Content="{x:Static properties:Strings.Word_Delete}"
                    Grid.Row="2"
                    x:Name="DeleteButton"/>

            <Button Command="{Binding SaveCommand}"
                    Content="{Binding SaveLabel}"
                    Grid.Column="1"
                    Grid.Row="2"
                    IsEnabled="{Binding CanSave}"
                    Margin="20,0"
                    x:Name="SaveButton"/>

            <Button Command="{Binding ReturnCommand}"
                    Content="{x:Static properties:Strings.Word_Return}"
                    Grid.Column="2"
                    Grid.Row="2"
                    x:Name="ReturnButton"/>
        </Grid>
    </Grid>
</UserControl>
