<Window x:Class="SylverInk.XAML.Properties"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:SylverInk"
		xmlns:vm="clr-namespace:SylverInk.XAML.ViewModels"
		mc:Ignorable="d"
		d:DataContext="{d:DesignInstance Type=vm:PropertiesViewModel}"
		Title="Sylver Ink: Properties"
		Height="625" Width="350" MouseLeftButtonDown="Drag" ShowInTaskbar="False" Topmost="True">
	<Grid Background="{Binding AppSettings.MenuBackground}">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<Popup Height="25" Placement="Mouse" PopupAnimation="Fade" StaysOpen="False" Width="160" x:Name="TimeSelector">
			<Border BorderBrush="{Binding AppSettings.MenuForeground}" BorderThickness="1">
				<Grid Background="{Binding AppSettings.MenuBackground}" HorizontalAlignment="Center" VerticalAlignment="Center">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding Hour, Mode=TwoWay}"/>
					<ComboBox Grid.Column="1" ItemsSource="{Binding Minutes}" SelectedItem="{Binding Minute, Mode=TwoWay}"/>
					<ComboBox Grid.Column="2" ItemsSource="{Binding Meridians}" SelectedItem="{Binding Meridian, Mode=TwoWay}"/>
				</Grid>
			</Border>
		</Popup>

		<Grid Grid.ColumnSpan="2" Margin="0,5">
			<Grid.RowDefinitions>
				<RowDefinition Height="*"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="3*"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="2*"/>
				<RowDefinition Height="2*"/>
				<RowDefinition Height="2*"/>
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="2*"/>
				<ColumnDefinition Width="3*"/>
			</Grid.ColumnDefinitions>

			<Separator Grid.ColumnSpan="2" Grid.Row="2"/>
			<Label Content="Created:" FontWeight="Bold" HorizontalAlignment="Right" Margin="5,0" Grid.Row="3"/>
			<Label Content="Format:" FontWeight="Bold" HorizontalAlignment="Right" Margin="5,0" Grid.Row="4"/>
			<Label Content="Path:" FontWeight="Bold" HorizontalAlignment="Right" Margin="5,0" Grid.Row="5"/>
			<Separator Grid.ColumnSpan="2" Grid.Row="6"/>
			<Label Content="Note count:" FontWeight="Bold" HorizontalAlignment="Right" Margin="5,0" Grid.Row="7"/>
			<Label FontWeight="Bold" HorizontalAlignment="Right" Margin="5,0" Grid.Row="8">
				<TextBlock TextAlignment="Right">Average note<LineBreak/>length:</TextBlock>
			</Label>
			<Label Content="Total length:" FontWeight="Bold" HorizontalAlignment="Right" Margin="5,0" Grid.Row="9"/>
			<Label Content="Longest note:" FontWeight="Bold" HorizontalAlignment="Right" Margin="5,0" Grid.Row="10"/>

			<TextBlock Grid.ColumnSpan="2" FontFamily="{Binding AppSettings.MainFontFamily}" FontSize="{Binding AppSettings.MainFontSize}" FontWeight="Bold" Foreground="{Binding AppSettings.MenuForeground}" Margin="5,0" Grid.Row="1" Text="{Binding DBName}" TextAlignment="Center" TextWrapping="WrapWithOverflow" VerticalAlignment="Center" x:Name="DBNameLabel"/>
			<Label Grid.Column="1" Content="{Binding DBCreated}" HorizontalAlignment="Left" Grid.Row="3" x:Name="DBCreatedLabel"/>
			<Label Grid.Column="1" Content="{Binding DBFormat}" HorizontalAlignment="Left" Grid.Row="4" x:Name="DBFormatLabel"/>
			<TextBlock Grid.Column="1" FontFamily="{Binding AppSettings.MainFontFamily}" FontSize="{Binding AppSettings.MainFontSize}" Foreground="{Binding AppSettings.MenuForeground}" HorizontalAlignment="Left" Margin="5,0" Grid.Row="5" Text="{Binding DBPath}" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" x:Name="DBPathLabel"/>
			<Label Grid.Column="1" Content="{Binding DBNotes}" HorizontalAlignment="Left" Grid.Row="7" x:Name="DBNotesLabel"/>
			<Label Grid.Column="1" Content="{Binding DBAvg}" HorizontalAlignment="Left" Grid.Row="8" x:Name="DBAvgLabel"/>
			<Label Grid.Column="1" Content="{Binding DBTotal}" HorizontalAlignment="Left" Grid.Row="9" x:Name="DBTotalLabel"/>
			<Label Grid.Column="1" Content="{Binding DBLongest}" HorizontalAlignment="Left" Grid.Row="10" x:Name="DBLongestLabel"/>
		</Grid>
		<Separator Grid.ColumnSpan="2" Grid.Row="1"/>
		<Grid Margin="0,2" Grid.ColumnSpan="2" Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<Label FontStyle="Italic" HorizontalAlignment="Right" Margin="10" VerticalAlignment="Center">
				<TextBlock>Restore the database<LineBreak/>to a previous state</TextBlock>
			</Label>

			<StackPanel Grid.Column="1" Margin="0,2,0,0" VerticalAlignment="Center">
				<DatePicker CalendarOpened="CalendarOpened" MaxWidth="120" SelectedDate="{Binding RestoreDate, Mode=TwoWay}"/>
				<Button Click="SelectTime" Content="{Binding TimeString}" FontStyle="Normal" Margin="0,5" Width="70" x:Name="SelectedTime"/>
				<Button Command="{Binding RestoreCommand}" Content="Restore" Margin="0,10,0,5"/>
			</StackPanel>
		</Grid>
		
		<Separator Grid.ColumnSpan="2" Grid.Row="3"/>
		<Button Grid.ColumnSpan="2" Command="{Binding CloseCommand}" Content="Close" Margin="0,20" Grid.Row="4"/>
	</Grid>
</Window>
