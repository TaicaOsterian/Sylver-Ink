<Window x:Class="SylverInk.XAML.About"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SylverInk"
        xmlns:properties="clr-namespace:SylverInk.Localization"
        xmlns:vm="clr-namespace:SylverInk.XAML.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}"
        Background="{Binding AppSettings.MenuBackground}" Foreground="{Binding AppSettings.MenuForeground}" Height="325" MouseLeftButtonDown="Drag" Title="{x:Static properties:Resources.Title_About}" ShowInTaskbar="False" Topmost="True" Width="400">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <TextBlock FontFamily="{Binding AppSettings.MainFontFamily}" FontSize="{Binding AppSettings.MainFontSize}" Margin="15" TextWrapping="WrapWithOverflow">
            <Run Text="{x:Static properties:Resources.AboutUs_Line1}"/><LineBreak/><LineBreak/>
            <Run Text="{x:Static properties:Resources.AboutUs_Line2}"/><LineBreak/>
            <Run Text="{x:Static properties:Resources.AboutUs_Line3}"/><LineBreak/><LineBreak/>
            <Hyperlink NavigateUri="{Binding AboutUsUri}" Command="{Binding NavigateCommand}" CommandParameter="{Binding AboutUsUri}"><Run Text="{x:Static properties:Resources.About_Github}"/></Hyperlink>
        </TextBlock>
        <Button Command="{Binding CloseCommand}" Content="{x:Static properties:Resources.Word_Close}" Grid.Row="1"/>
    </Grid>
</Window>
