<Window x:Class="SylverInk.XAML.About"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SylverInk"
        xmlns:vm="clr-namespace:SylverInk.XAML.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}"
        Background="{Binding AppSettings.MenuBackground}" Foreground="{Binding AppSettings.MenuForeground}" Height="325" MouseLeftButtonDown="Drag" Title="Sylver Ink: About" ShowInTaskbar="False" Topmost="True" Width="400">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <TextBlock FontFamily="{Binding AppSettings.MainFontFamily}" FontSize="{Binding AppSettings.MainFontSize}" Margin="15" TextWrapping="WrapWithOverflow">
            <Bold>Sylver Ink</Bold> is released under the MIT software license. You are free to modify and redistribute Sylver Ink as you see fit, provided no claim is made to patent rights.<LineBreak/><LineBreak/>
            With special thanks to <Bold>Miles Farber</Bold> for the priceless contribution of encouraging words and helpful brainstorming.<LineBreak/><LineBreak/>
            And to <Bold>Norvinsk Hunter</Bold> for his invaluable insight into the wants and needs of our target audience.<LineBreak/><LineBreak/>
            <Hyperlink NavigateUri="{Binding AboutUsUri}" Command="{Binding NavigateCommand}" CommandParameter="{Binding AboutUsUri}">Visit us on Github.</Hyperlink>
        </TextBlock>
        <Button Command="{Binding CloseCommand}" Content="Close" Grid.Row="1"/>
    </Grid>
</Window>
