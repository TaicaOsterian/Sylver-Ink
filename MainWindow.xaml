<Window x:Class="SylverInk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:properties="clr-namespace:SylverInk.Localization"
        xmlns:vm="clr-namespace:SylverInk.XAML.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        x:Name="RootWindow"
        Background="{Binding AppSettings.MenuBackground}"
        Closing="MainWindow_Closing"
        Foreground="{Binding AppSettings.MenuForeground}"
        Height="625" MinHeight="450" MinWidth="400"
        MouseLeftButtonDown="Drag" ResizeMode="NoResize"
        SizeChanged="MainWindow_SizeChanged" Title="Sylver Ink" Width="450">
    <Grid Background="{Binding AppSettings.AccentBackground}" IsEnabled="{Binding GridEnabled}" x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Popup IsOpen="{Binding RenamePopupVisible, Mode=TwoWay}"
            Height="75" Placement="Mouse" PopupAnimation="Fade"
            StaysOpen="False" Width="275" x:Name="RenameDatabase">
            <Border BorderBrush="{Binding AppSettings.MenuForeground}" BorderThickness="1">
                <Grid Background="{Binding AppSettings.MenuBackground}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox Width="250" Margin="0,10" Text="{Binding RenameDatabaseName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" x:Name="DatabaseNameBox">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding RenamePopupEnterCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding RenamePopupEscapeCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Center">
                        <Button Command="{Binding SaveRenameCommand}" Content="{x:Static properties:Resources.Word_Save}" Margin="5"/>
                        <Button Command="{Binding CancelRenameCommand}" Content="{x:Static properties:Resources.Word_Cancel}" Margin="5"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>
        
        <Popup IsOpen="{Binding ConnectPopupVisible, Mode=TwoWay}"
               Height="75" Placement="Mouse" PopupAnimation="Fade"
               StaysOpen="False" Width="275" x:Name="ConnectAddress">
            <Border BorderBrush="{Binding AppSettings.MenuForeground}" BorderThickness="1">
                <Grid Background="{Binding AppSettings.MenuBackground}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Content="{x:Static properties:Resources.AddressCode}"/>
                        <TextBox Width="75" Margin="0,10"
                                 Text="{Binding AddressCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 x:Name="AddressBox">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ConnectPopupEnterCommand}" />
                                <KeyBinding Key="Escape" Command="{Binding ConnectPopupEscapeCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Label Content="(?)" Foreground="{Binding AppSettings.AccentForeground}" ToolTip="{x:Static properties:Resources.ConnectLabelTooltip}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Center">
                        <Button Command="{Binding SaveConnectCommand}" Content="{x:Static properties:Resources.Word_Connect}" Margin="5"/>
                        <Button Command="{Binding CancelConnectCommand}" Content="{x:Static properties:Resources.Word_Cancel}" Margin="5"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>
        
        <Popup IsOpen="{Binding CodePopupVisible, Mode=TwoWay}"
               Height="75" Placement="Mouse" PopupAnimation="Fade"
               StaysOpen="False" Width="275" x:Name="CodePopup">
            <Border BorderBrush="{Binding AppSettings.MenuForeground}" BorderThickness="1">
                <Grid Background="{Binding AppSettings.MenuBackground}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Content="{x:Static properties:Resources.AddressCode}"/>
                        <TextBox Margin="0,10" IsReadOnly="True" Width="75"
                                 Text="{Binding AddressCodeDisplay, Mode=OneWay}"
                                 x:Name="CodeBox"/>
                        <Label Content="(?)" Foreground="{Binding AppSettings.AccentForeground}" ToolTip="{x:Static properties:Resources.ServerCodeLabelTooltip}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Center">
                        <Button Command="{Binding CopyAddressCodeCommand}" Content="{x:Static properties:Resources.Word_Copy}" Margin="5"/>
                        <Button Command="{Binding CloseCodePopupCommand}" Content="{x:Static properties:Resources.Word_Close}" Margin="5"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>
        
        <Menu x:Name="DatabaseMenu">
            <MenuItem Header="{x:Static properties:Resources.Word_File}" Height="25">
                <MenuItem Command="{Binding NewDatabaseCommand}" Header="{x:Static properties:Resources.DefaultDatabase}" Tag="Always"/>
                <MenuItem Command="{Binding OpenDatabaseCommand}" Header="{x:Static properties:Resources.Word_OpenEllipsis}" Tag="Always"/>
                <MenuItem Header="{x:Static properties:Resources.OpenRecent}" ItemsSource="{Binding AppSettings.RecentDatabases}" Tag="Recents">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding}" />
                            <Setter Property="Command"
                                    Value="{Binding DataContext.OpenRecentFileCommand,
                                            RelativeSource={RelativeSource AncestorType=Menu}}" />
                            <Setter Property="CommandParameter" Value="{Binding FullPath}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator/>
                <MenuItem Command="{Binding SaveLocalCommand}" Header="{x:Static properties:Resources.SaveToDocuments}" Tag="Always"/>
                <MenuItem Command="{Binding SaveAsCommand}" Header="{x:Static properties:Resources.SaveAs}" Tag="Always"/>
                <MenuItem Command="{Binding BackupDatabaseCommand}" Header="{x:Static properties:Resources.Backup}" Tag="Always"/>
                <Separator/>
                <MenuItem Command="{Binding DeleteDatabaseCommand}" Header="{x:Static properties:Resources.Word_Delete}"/>
            </MenuItem>
            <MenuItem Header="{x:Static properties:Resources.Word_Database}" Height="25">
                <MenuItem Command="{Binding CloseDatabaseCommand}" Header="{x:Static properties:Resources.Word_Close}"/>
                <MenuItem Command="{Binding RenameDatabaseCommand}" Header="{x:Static properties:Resources.Word_Rename}" Tag="Always"/>
                <Separator/>
                <MenuItem Command="{Binding PropertiesCommand}" Header="{x:Static properties:Resources.Word_Properties}" Tag="Always"/>
            </MenuItem>
            <MenuItem Header="{x:Static properties:Resources.Word_Network}" Height="25">
                <MenuItem Command="{Binding ConnectCommand}" Header="{x:Static properties:Resources.Word_Connect}" Tag="NotConnected"/>
                <MenuItem Command="{Binding DisconnectCommand}" Header="{x:Static properties:Resources.Word_Disconnect}" Tag="Connected"/>
                <Separator/>
                <MenuItem Command="{Binding UnserveCommand}" Header="{x:Static properties:Resources.CloseToNetwork}" Tag="Serving"/>
                <MenuItem Command="{Binding ServeCommand}" Header="{x:Static properties:Resources.OpenToNetwork}" Tag="NotServing"/>
                <MenuItem Command="{Binding CopyCodeCommand}" Header="{x:Static properties:Resources.CopyAddressCode}" Tag="Serving"/>
            </MenuItem>
            <MenuItem Header="{x:Static properties:Resources.Word_Help}" Height="25">
                <MenuItem Command="{Binding AboutCommand}" Header="{x:Static properties:Resources.Word_About}" Tag="Always"/>
            </MenuItem>
        </Menu>

        <Label Content="{x:Static properties:Resources.SylverInk}" FontSize="16" FontStyle="Italic" FontWeight="Light" Grid.Row="1" HorizontalAlignment="Center" Margin="0,15" VerticalAlignment="Top"/>
        <TabControl Background="{Binding AppSettings.MenuBackground}" BorderThickness="0" Foreground="{Binding AppSettings.MenuForeground}" Grid.Row="2" SelectionChanged="MenuTabChanged" x:Name="DatabasesPanel"/>
        <Label Content="{Binding AppSettings.VersionString}" FontSize="9" FontStyle="Italic" FontWeight="Light" HorizontalAlignment="Right" Margin="0,5" Grid.Row="3" VerticalAlignment="Bottom"/>
    </Grid>
</Window>