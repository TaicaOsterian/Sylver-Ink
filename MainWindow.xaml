<Window x:Class="SylverInk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:properties="clr-namespace:SylverInk.Localization"
        xmlns:vm="clr-namespace:SylverInk.XAML.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        x:Name="RootWindow"
        Background="{Binding AppSettings.MenuBackground}"
        Closing="MainWindow_Closing"
        Foreground="{Binding AppSettings.MenuForeground}"
        Height="625"
        MinHeight="450"
        MinWidth="400"
        MouseLeftButtonDown="Drag"
        ResizeMode="NoResize"
        SizeChanged="MainWindow_SizeChanged"
        Title="Sylver Ink"
        Width="450">
    <Grid Background="{Binding AppSettings.AccentBackground}"
          IsEnabled="{Binding AppSettings.GridEnabled}"
          x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Popup Focusable="True"
               IsOpen="{Binding DatabaseMenu.RenamePopupVisible, Mode=TwoWay}"
               Height="75"
               Placement="Mouse"
               PopupAnimation="Fade"
               StaysOpen="False"
               Width="275"
               x:Name="RenameDatabase">
            <Border BorderBrush="{Binding AppSettings.MenuForeground}"
                    BorderThickness="1">
                <Grid Background="{Binding AppSettings.MenuBackground}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox AutomationProperties.HelpText="{x:Static properties:Strings.HelpText_Rename}"
                             AutomationProperties.Name="{x:Static properties:Strings.Word_Rename}"
                             Margin="0,10"
                             Text="{Binding DatabaseMenu.RenameDatabaseName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="250"
                             x:Name="DatabaseNameBox">
                        <TextBox.InputBindings>
                            <KeyBinding Command="{Binding DatabaseMenu.RenamePopupEnterCommand}"
                                        Key="Enter" />

                            <KeyBinding Command="{Binding DatabaseMenu.RenamePopupEscapeCommand}"
                                        Key="Escape" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                        <Button Command="{Binding DatabaseMenu.SaveRenameCommand}"
                                Content="{x:Static properties:Strings.Word_Save}"
                                Margin="5" />

                        <Button Command="{Binding DatabaseMenu.CancelRenameCommand}"
                                Content="{x:Static properties:Strings.Word_Cancel}"
                                Margin="5" />
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>

        <Popup Focusable="True"
               Height="75"
               IsOpen="{Binding NetworkMenu.ConnectPopupVisible, Mode=TwoWay}"
               Placement="Mouse"
               PopupAnimation="Fade"
               StaysOpen="False"
               Width="275"
               x:Name="ConnectAddress">
            <Border BorderBrush="{Binding AppSettings.MenuForeground}"
                    BorderThickness="1">
                <Grid Background="{Binding AppSettings.MenuBackground}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Label AutomationProperties.HelpText="{x:Static properties:Strings.ConnectLabelTooltip}"
                               Content="{x:Static properties:Strings.Label_AddressCode}"
                               x:Name="AddressCodeLabel" />

                        <TextBox AutomationProperties.LabeledBy="{Binding ElementName=AddressCodeLabel}"
                                 Margin="0,10"
                                 Text="{Binding NetworkMenu.AddressCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 x:Name="AddressBox">
                            <TextBox.InputBindings>
                                <KeyBinding Command="{Binding NetworkMenu.ConnectPopupEnterCommand}"
                                            Key="Enter" />

                                <KeyBinding Command="{Binding NetworkMenu.ConnectPopupEscapeCommand}"
                                            Key="Escape" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <Label Foreground="{Binding AppSettings.AccentForeground}"
                               ToolTip="{x:Static properties:Strings.ConnectLabelTooltip}">
                            <TextBlock Text="(?)"
                                       TextDecorations="Underline" />
                        </Label>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                        <Button Command="{Binding NetworkMenu.SaveConnectCommand}"
                                Content="{x:Static properties:Strings.Word_Connect}"
                                Margin="5" />

                        <Button Command="{Binding NetworkMenu.CancelConnectCommand}"
                                Content="{x:Static properties:Strings.Word_Cancel}"
                                Margin="5" />
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>

        <Popup Height="75"
               IsOpen="{Binding NetworkMenu.CodePopupVisible, Mode=TwoWay}"
               Placement="Mouse"
               PopupAnimation="Fade"
               StaysOpen="False"
               Width="275"
               x:Name="CodePopup">
            <Border BorderBrush="{Binding AppSettings.MenuForeground}"
                    BorderThickness="1">
                <Grid Background="{Binding AppSettings.MenuBackground}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Label Content="{x:Static properties:Strings.Label_AddressCode}" />

                        <TextBox IsReadOnly="True"
                                 Margin="0,10"
                                 Text="{Binding NetworkMenu.AddressCodeDisplay, Mode=OneWay}"
                                 x:Name="CodeBox" />

                        <Label Foreground="{Binding AppSettings.AccentForeground}"
                               ToolTip="{x:Static properties:Strings.ServerCodeLabelTooltip}">
                            <TextBlock Text="(?)"
                                       TextDecorations="Underline" />
                        </Label>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                        <Button Command="{Binding NetworkMenu.CopyAddressCodeCommand}"
                                Content="{x:Static properties:Strings.Word_Copy}"
                                Margin="5" />

                        <Button Command="{Binding NetworkMenu.CloseCodePopupCommand}"
                                Content="{x:Static properties:Strings.Word_Close}"
                                Margin="5" />
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>

        <Menu x:Name="DatabaseMenu">
            <MenuItem Header="{x:Static properties:Strings.Word_File}"
                      Height="25">
                <MenuItem Command="{Binding FileMenu.NewDatabaseCommand}"
                          Header="{x:Static properties:Strings.Word_New}" />

                <MenuItem Command="{Binding FileMenu.OpenDatabaseCommand}"
                          Header="{x:Static properties:Strings.Label_Open}" />

                <MenuItem Command="{Binding FileMenu.OpenRecentFileCommand}"
                          Header="{x:Static properties:Strings.OpenRecent}"
                          ItemsSource="{Binding AppSettings.RecentDatabases}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem"
                               BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Command"
                                    Value="{Binding DataContext.FileMenu.OpenRecentFileCommand,
                                            RelativeSource={RelativeSource AncestorType=Window}}" />

                            <Setter Property="CommandParameter"
                                    Value="{Binding FullPath}" />

                            <Setter Property="Header"
                                    Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>

                <MenuItem Command="{Binding FileMenu.ImportCommand}"
                          Header="{x:Static properties:Strings.Word_Import}" />

                <Separator />

                <MenuItem Command="{Binding FileMenu.SaveLocalCommand}"
                          Header="{x:Static properties:Strings.SaveToDocuments}" />

                <MenuItem Command="{Binding FileMenu.SaveAsCommand}"
                          Header="{x:Static properties:Strings.Label_SaveAs}" />

                <MenuItem Header="{x:Static properties:Strings.Label_Browse}">
                    <MenuItem Command="{Binding FileMenu.BrowseFolderCommand}"
                              CommandParameter="{x:Static properties:Strings.Subfolder_Databases}"
                              Header="{x:Static properties:Strings.Subfolder_Databases}" />

                    <MenuItem Command="{Binding FileMenu.BrowseFolderCommand}"
                              CommandParameter="{x:Static properties:Strings.Subfolder_Backups}"
                              Header="{x:Static properties:Strings.Subfolder_Backups}" />
                </MenuItem>

                <Separator />

                <MenuItem Command="{Binding FileMenu.DeleteDatabaseCommand}"
                          Header="{x:Static properties:Strings.Word_Delete}" />
            </MenuItem>

            <MenuItem Header="{x:Static properties:Strings.Word_Database}"
                      Height="25">
                <MenuItem Command="{Binding DatabaseMenu.CloseDatabaseCommand}"
                          Header="{x:Static properties:Strings.Word_Close}" />

                <MenuItem Command="{Binding DatabaseMenu.RenameDatabaseCommand}"
                          Header="{x:Static properties:Strings.Word_Rename}" />

                <Separator />

                <MenuItem Command="{Binding DatabaseMenu.BackupDatabaseCommand}"
                          Header="{x:Static properties:Strings.Label_Backup}" />

                <MenuItem Command="{Binding DatabaseMenu.PropertiesCommand}"
                          Header="{x:Static properties:Strings.Word_Properties}" />
            </MenuItem>

            <MenuItem Header="{x:Static properties:Strings.Word_Network}"
                      Height="25">
                <MenuItem Command="{Binding NetworkMenu.ConnectCommand}"
                          Header="{x:Static properties:Strings.Word_Connect}" />

                <MenuItem Command="{Binding NetworkMenu.DisconnectCommand}"
                          Header="{x:Static properties:Strings.Word_Disconnect}" />

                <Separator />

                <MenuItem Command="{Binding NetworkMenu.UnserveCommand}"
                          Header="{x:Static properties:Strings.CloseToNetwork}" />

                <MenuItem Command="{Binding NetworkMenu.ServeCommand}"
                          Header="{x:Static properties:Strings.OpenToNetwork}" />

                <MenuItem Command="{Binding NetworkMenu.CopyCodeCommand}"
                          Header="{x:Static properties:Strings.CopyAddressCode}" />
            </MenuItem>

            <MenuItem Header="{x:Static properties:Strings.Word_Help}"
                      Height="25">
                <MenuItem Command="{Binding HelpMenu.CheckForUpdatesCommand}"
                          Header="{x:Static properties:Strings.CheckForUpdates}" />

                <Separator />

                <MenuItem Command="{Binding HelpMenu.AboutCommand}"
                          Header="{x:Static properties:Strings.Word_About}" />
            </MenuItem>
        </Menu>

        <Label Content="Sylver Ink"
               FontSize="16"
               FontStyle="Italic"
               FontWeight="Light"
               Foreground="{Binding AppSettings.MenuForeground}"
               Grid.Row="1"
               HorizontalAlignment="Center"
               Margin="0,15"
               VerticalAlignment="Top" />

        <TabControl Background="{Binding AppSettings.MenuBackground}"
                    BorderThickness="0"
                    Foreground="{Binding AppSettings.MenuForeground}"
                    Grid.Row="2"
                    SelectionChanged="MenuTabChanged"
                    x:Name="DatabasesPanel" />

        <Label Content="{Binding AppSettings.VersionString}"
               FontSize="9"
               FontStyle="Italic"
               FontWeight="Light"
               Foreground="{Binding AppSettings.MenuForeground}"
               Grid.Row="3"
               HorizontalAlignment="Right"
               Margin="0,5"
               VerticalAlignment="Bottom" />
    </Grid>
</Window>
